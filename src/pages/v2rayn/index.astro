---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBrands } from '../../utils/data';

const allBrands = await getBrands();
const recommended = [...allBrands].sort((a, b) => a.data.sort_order - b.data.sort_order).slice(0, 8);

const faqs = [
    {
        q: 'V2rayN 和 V2ray 是什么关系？',
        a: 'V2ray 是底层的代理协议/核心程序，V2rayN 是运行在 Windows 上的图形界面客户端，内置或可切换 V2ray、Xray 等核心，方便普通用户通过界面而不是命令行来配置和使用。'
    },
    {
        q: 'V2rayN 打开报毒或被杀毒软件拦截怎么办？',
        a: '请务必从官方 GitHub Release 页面下载，不要使用来源不明的打包版本。部分杀毒软件会对代理类工具误报，可在确认下载来源可靠后将其加入信任名单，切勿因此关闭系统的核心防护功能。'
    },
    {
        q: '批量导入订阅后节点列表是空的？',
        a: '先确认订阅链接是否已过期或流量耗尽；再检查是否点击了"订阅 - 更新所有订阅"；如果依然无节点，可能是订阅链接本身需要特定网络环境才能访问，可尝试更换网络后重试。'
    }
];

const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') }
    }))
};
---

<BaseLayout
    title="V2rayN 机场推荐与订阅导入教程 2026"
    description="V2rayN 怎么下载安装、怎么导入机场订阅链接？介绍 Windows 端 V2rayN 客户端的使用步骤，并附本站收录的机场推荐列表。"
    structuredData={faqSchema}
>
    <div class="container">
        <div style="margin-bottom: 2rem;">
            <div class="breadcrumbs" style="margin-bottom: 1rem; color: var(--text-muted); font-size: 0.9rem;">
                <a href="/" style="color: var(--primary); text-decoration: none;">首页</a> &gt; <a href="/tutorial/" style="color: var(--primary); text-decoration: none;">使用教程</a> &gt; <span>V2rayN</span>
            </div>
            <h1>V2rayN 机场推荐与订阅导入教程</h1>
        </div>

        <div class="article-content" style="background: var(--card-bg); padding: 2rem; border-radius: 8px; border: 1px solid var(--border-color);">

            <div style="background: var(--bg-alt); padding: 1rem 1.5rem; border-radius: 8px; margin-bottom: 2rem; border-left: 4px solid var(--primary);">
                <strong>快速说明：</strong>V2rayN 是 Windows 平台上最常用的开源代理客户端之一，免费、界面简单，本身不含节点，需要搭配机场订阅使用。
            </div>

            <h2>一、V2rayN 是什么</h2>
            <p>V2rayN 是运行在 Windows 上的图形化客户端，支持 V2ray、Xray 等多种核心与协议，社区活跃、更新频繁，是很多机场官方教程默认推荐的 Windows 客户端之一。</p>

            <h2>二、下载安装</h2>
            <ul>
                <li><strong>下载来源：</strong>请前往 V2rayN 官方 GitHub Release 页面下载最新版本压缩包，解压后运行 <code>v2rayN.exe</code> 即可，无需安装。</li>
                <li><strong>杀毒软件误报：</strong>部分安全软件会对代理工具误报，确认下载来源可靠后加入信任名单即可，不要长期关闭系统防护，详见 <a href="/tutorial/windows/">Windows 配置教程</a>中的安全提醒。</li>
            </ul>

            <h2>三、导入机场订阅</h2>
            <ol>
                <li>登录机场后台，复制订阅链接。</li>
                <li>打开 V2rayN，点击顶部菜单"订阅 (Subscription) → 订阅设置"，添加一条新订阅并粘贴链接。</li>
                <li>回到菜单点击"订阅 → 更新所有订阅"，等待节点列表加载完成。</li>
                <li>在主界面服务器列表中双击选择一个节点。</li>
                <li>右下角托盘图标右键，选择"系统代理 → 自动配置系统代理"以接管流量。</li>
            </ol>
            <p>不清楚订阅链接是什么，可以先看 <a href="/knowledge/subscription/">机场订阅详解</a>；不清楚该选哪个节点，可以看 <a href="/knowledge/node/">节点知识</a>。</p>

            <h2>四、常见问题</h2>
            {faqs.map(f => (
                <div style="margin-bottom: 1.5rem;">
                    <strong>Q: {f.q}</strong>
                    <p style="margin-top: 0.5rem;" set:html={f.a} />
                </div>
            ))}

            <h2>五、支持 V2rayN 的机场推荐</h2>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">标准机场订阅链接普遍兼容 V2rayN，以下按本站收录顺序列出，具体价格与流量以各页面标注日期的数据为准，晚高峰速率与解锁效果本站未做独立实测。</p>

            <div style="display: grid; gap: 1rem;">
                {recommended.map(brand => (
                    <div style="border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
                        <div>
                            <a href={`/brands/${encodeURIComponent(brand.id)}/`} style="color: var(--primary); font-weight: bold; text-decoration: none; font-size: 1.05rem;">{brand.data.name}</a>
                            <div style="color: var(--text-muted); font-size: 0.85rem; margin-top: 0.25rem;">
                                流量 {brand.data.bandwidth_gb}GB（{brand.data.bandwidth_reset_period === 'monthly' ? '按月重置' : brand.data.bandwidth_reset_period}） · {brand.data.evidence_status}
                            </div>
                        </div>
                        <div style="text-align: right;">
                            <div style="font-weight: bold;">{brand.data.currency} {brand.data.price_yearly ?? brand.data.price_monthly}{brand.data.price_yearly ? '/年' : '/月'}</div>
                        </div>
                    </div>
                ))}
            </div>
            <p style="margin-top: 1.5rem;"><a href="/paihangbang/">查看完整机场排行榜 →</a></p>

        </div>
    </div>
</BaseLayout>
