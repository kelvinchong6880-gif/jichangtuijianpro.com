---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBrands } from '../../utils/data';

const allBrands = await getBrands();
---

<BaseLayout title="优质机场怎么选：证据与限制核对" description="核对机场服务质量所需的测试证据、套餐限制和资料来源。当前收录品牌尚无本站独立实测。">
  
  <div class="max-w-4xl mx-auto space-y-8">
    <div class="border-b border-gray-200 pb-5">
      <h1 class="text-3xl font-extrabold text-gray-900">优质机场怎么选</h1>
      <p class="mt-3 text-xl text-gray-500">
        价格高、线路名称或官方宣传不能单独证明服务质量。当前收录品牌均未由本站独立实测，因此这里暂不发布质量排名。选择时请核对您所在地区和使用时段的晚高峰测试、流量倍率、设备限制与退款条件。
      </p>
    </div>

    <div class="space-y-8">
      {allBrands.map((brand: any) => (
        <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
            <h2 class="text-xl font-bold text-gray-900">
              {brand.data.name}
            </h2>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
              证据状态: {brand.data.evidence_status}
            </span>
          </div>
          <div class="p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <h4 class="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-2">基础信息</h4>
                <ul class="text-sm text-gray-600 space-y-2">
                  <li>月付记录: {brand.data.price_monthly ? `${brand.data.currency} ${brand.data.price_monthly}` : '资料未提供'}</li>
                  <li>年付记录: {brand.data.price_yearly ? `${brand.data.currency} ${brand.data.price_yearly}` : '资料未提供'}</li>
                  <li>设备限制: {brand.data.device_limit ? `${brand.data.device_limit} 台` : '未说明'}</li>
                  <li>退款政策: {brand.data.refund_policy || '未说明'}</li>
                </ul>
              </div>
              <div>
                <h4 class="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-2">证据范围</h4>
                <div class="bg-gray-100 rounded p-4 text-sm text-gray-600 border border-gray-200">
                  <p>{brand.data.evidence_status}。资料核验日期：{brand.data.verification_date}。</p>
                  <p class="mt-1">暂无可复核的本站晚高峰测速和解锁记录，不据此判断稳定性。</p>
                </div>
              </div>
            </div>
            <div class="mt-4 pt-4 border-t border-gray-200">
              <a href={`/brands/${brand.id}/`} class="text-blue-600 hover:text-blue-500 text-sm font-medium">查看品牌资料与套餐 &rarr;</a>
            </div>
          </div>
        </div>
      ))}
    </div>
    
  </div>

</BaseLayout>
