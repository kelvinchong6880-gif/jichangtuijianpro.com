---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Promo from '../../components/Promo.astro';
import BrandName from '../../components/BrandName.astro';
import { render } from 'astro:content';
import {
  getBrandViews, avgEntryPrice, perGB, fmtGB, fmtPrice, faqSchema, breadcrumbSchema,
  SITE_URL, SITE_NAME, UPDATED, UPDATED_LABEL, UPDATED_MONTH, PAIRS, pairSlug, type BrandView,
} from '../../utils/data';
import { USAGE, cheapestFor, planPriceText, unlockText, oneLiner, prosCons, brandFaq } from '../../utils/review';

export async function getStaticPaths() {
  const brands = await getBrandViews();
  return brands.map((b) => ({ params: { slug: b.slug }, props: { b, all: brands } }));
}

const { b, all } = Astro.props as { b: BrandView; all: BrandView[] };
const { Content } = await render(b.entry_data);
const evidence = b.entry_data.data.evidence_images ?? [];
const avg = avgEntryPrice(all);
const { pros, cons } = prosCons(b, avg);
const faq = brandFaq(b);
const rank = all.findIndex((x) => x.slug === b.slug) + 1;
const rivals = all
  .filter((x) => x.slug !== b.slug && x.entry && b.entry)
  .sort((x, y) => Math.abs(x.entry!.price - b.entry!.price) - Math.abs(y.entry!.price - b.entry!.price) || x.rank - y.rank)
  .slice(0, 4);
const pairs = PAIRS.filter(([x, y]) => x === b.slug || y === b.slug);
const bySlug = Object.fromEntries(all.map((x) => [x.slug, x]));

const title = `${b.name}怎么样？2026 ${b.name}机场评测：套餐价格、线路与优惠码`;
const description = `${b.name}机场评测（${UPDATED_MONTH}更新）：${oneLiner(b)}。${b.plans.length}个套餐价格表、按用量怎么选、优缺点、同价位对比${b.promo ? `，优惠码${b.promo}` : ''}。`;

const schemas = [
  faqSchema(faq),
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `${b.name} 机场订阅`,
    brand: { '@type': 'Brand', name: b.name },
    description: oneLiner(b),
    offers: b.plans.length
      ? {
          '@type': 'AggregateOffer',
          priceCurrency: 'CNY',
          lowPrice: Math.min(...b.plans.map((p) => p.price)),
          highPrice: Math.max(...b.plans.map((p) => p.price)),
          offerCount: b.plans.length,
          url: `${SITE_URL}${b.url}`,
        }
      : undefined,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    inLanguage: 'zh-CN',
    datePublished: '2026-09-18',
    dateModified: `${UPDATED}T00:00:00+08:00`,
    author: { '@type': 'Organization', name: `${SITE_NAME}编辑部`, url: `${SITE_URL}/` },
    publisher: { '@type': 'Organization', name: SITE_NAME, url: `${SITE_URL}/` },
    mainEntityOfPage: `${SITE_URL}${b.url}`,
  },
  breadcrumbSchema([{ name: '机场测评', path: '/ceping/' }, { name: b.name, path: b.url }]),
];
---
<BaseLayout title={title} description={description} structuredData={schemas} ogType="article">
  <article class="k-page">
    <div class="k-eyebrow"><a href="/">机场推荐</a> / <a href="/ceping/">机场测评</a> / {b.name} · 更新于 <time datetime={UPDATED}>{UPDATED_LABEL}</time></div>
    <div class="k-actions" style="gap:14px; margin-bottom:8px">
      {b.logo && <img src={b.logo} alt={`${b.name} logo`} width="56" height="56" style="width:56px;height:56px;object-fit:contain;background:#fff;border-radius:8px;padding:3px" />}
      <h1 style="margin:0">{b.name}怎么样？{b.name}机场评测与套餐选购</h1>
    </div>
    <p class="k-lead">{b.name}{oneLiner(b)}，在本站 <a href="/paihangbang/">机场排行榜</a> 排第 {rank} 名。下面是它的全部套餐、按用量的选购建议、优缺点和同价位对比。</p>

    <div class="k-callout">
      <div class="k-grid" style="grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap:10px; margin-bottom:12px">
        <div><div class="k-muted">月付起步</div><strong class="k-num">{b.entry ? `${fmtPrice(b.entry.price)}/月` : '无月付'}</strong></div>
        <div><div class="k-muted">年付最低</div><strong class="k-num">{b.minYearly ? `${fmtPrice(b.minYearly.price)}/年` : '无'}</strong></div>
        <div><div class="k-muted">线路</div><strong>{b.lineLabel}</strong></div>
        <div><div class="k-muted">每月流量</div><strong class="k-num">{fmtGB(b.minTraffic)}–{fmtGB(b.maxTraffic)}</strong></div>
        <div><div class="k-muted">不限时包</div><strong>{b.oneTime.length ? `${b.oneTime.length} 款` : '无'}</strong></div>
        <div><div class="k-muted">解锁</div><strong>{unlockText(b)}</strong></div>
      </div>
      <div class="k-actions">
        <a class="k-btn k-btn-solid" href={b.register} target="_blank" rel="nofollow sponsored noopener">前往 {b.name} 官网</a>
        <Promo code={b.promo} />
      </div>
    </div>

    <section class="k-section prose prose-invert max-w-none">
      <Content />
    </section>

    {evidence.length > 0 && (
      <section class="k-section" id="test">
        <h2>{b.name}节点延迟实测</h2>
        <p>以下是本站 2026 年 9 月在客户端里对 {b.name} 节点做的延迟测试截图（单位 ms，数值越低越好）。部分读数：新加坡01 10ms、台湾10 36ms、日本01 46ms、香港01 53ms、直连德国01 84ms、美国02 100ms。延迟测试反映连通性和响应速度，不等于下载速度；个别节点（新加坡04、台湾04）当次显示超时，切换同地区其他节点即可。</p>
        <div class="k-grid" style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));">
          {evidence.map((img, i) => (
            <figure style="margin:0; border:1px solid var(--pa-amber-border)">
              <a href={img.src} target="_blank" rel="noopener"><img src={img.src} alt={img.alt} width={img.width} height={img.height} loading="lazy" decoding="async" style="width:100%;height:auto;display:block" /></a>
              <figcaption class="k-muted" style="padding:6px 8px">实测截图 {i + 1}/{evidence.length}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <section class="k-section">
      <h2>{b.name}套餐怎么选</h2>
      <div class="k-table-wrap">
        <table class="k-table">
          <thead><tr><th scope="col">你的用量</th><th scope="col">每月需要</th><th scope="col">推荐套餐</th><th scope="col">价格</th></tr></thead>
          <tbody>
            {USAGE.map((u) => {
              const p = cheapestFor(b, u.need);
              return <tr><td><strong>{u.label}</strong><br /><span class="k-muted">{u.desc}</span></td><td class="k-num">{u.need}GB+</td><td>{p ? `${p.name}（${fmtGB(p.traffic)}/月）` : '无合适档位'}</td><td class="k-num">{p ? planPriceText(p) : '—'}</td></tr>;
            })}
          </tbody>
        </table>
      </div>
      {b.bestValue && <p>按每 GB 计算，{b.name}最划算的是 <strong>{b.bestValue.name}</strong>，约 ¥{perGB(b.bestValue)!.toFixed(3)}/GB。{b.oneTime.length ? `偶尔才用的话，不限时包 ${fmtPrice(b.oneTime[0].price)} 起，流量不过期。` : ''}</p>}
    </section>

    <section class="k-section">
      <h2>{b.name}优缺点</h2>
      <div class="k-grid" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));">
        <div class="k-card"><strong>优点</strong><ul class="k-list" style="margin:0">{pros.map((x) => <li>{x}</li>)}</ul></div>
        <div class="k-card"><strong>需要注意</strong><ul class="k-list" style="margin:0">{cons.length ? cons.map((x) => <li>{x}</li>) : <li>暂无明显短板，建议先月付确认本地网络体验。</li>}</ul></div>
      </div>
    </section>

    <section class="k-section">
      <h2>{b.name}和同价位机场对比</h2>
      <div class="k-table-wrap">
        <table class="k-table">
          <thead><tr><th scope="col">机场</th><th scope="col">月付起步</th><th scope="col">线路</th><th scope="col">流量范围</th><th scope="col">不限时</th><th scope="col">解锁</th></tr></thead>
          <tbody>
            {[b, ...rivals].map((x) => (
              <tr class={x.slug === b.slug ? 'is-hl' : ''}><td><BrandName b={x} /></td><td class="k-num">{x.entry ? `${fmtPrice(x.entry.price)} / ${fmtGB(x.entry.traffic)}` : '—'}</td><td>{x.lineLabel}</td><td class="k-num">{fmtGB(x.minTraffic)}–{fmtGB(x.maxTraffic)}</td><td>{x.oneTime.length ? '有' : '无'}</td><td>{unlockText(x)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      {pairs.length > 0 && (
        <p>详细对比：{pairs.map(([x, y], i) => <>{i > 0 && ' · '}<a href={`/duibi/${pairSlug(x, y)}/`}>{bySlug[x].name}和{bySlug[y].name}哪个好</a></>)}</p>
      )}
      <p>更多选择：<a href="/paihangbang/">机场排行榜</a> · <a href="/xingjiabi/">性价比机场</a> · <a href="/pianyi/">便宜机场</a> · <a href="/duibi/">机场对比</a></p>
    </section>

    <section class="k-section">
      <h2>{b.name}购买和使用步骤</h2>
      <ol class="k-list">
        <li>点击上方“前往 {b.name} 官网”，用邮箱注册账号。</li>
        <li>按上面的用量表选好套餐，第一次建议选月付。</li>
        {b.promo ? <li>结算页填写优惠码 <code>{b.promo}</code>，确认金额后付款。</li> : <li>结算前留意官网公告里的限时折扣。</li>}
        <li>在用户中心复制订阅链接，导入客户端：电脑用 <a href="/clash/">Clash</a> 或 <a href="/v2rayn/">V2rayN</a>，iPhone 用 <a href="/xiaohuojian/">小火箭</a>，安卓看 <a href="/tutorial/android/">安卓教程</a>。</li>
        <li>晚上 8–11 点测一次常用网站，确认速度满意后再考虑年付。</li>
      </ol>
    </section>

    <section class="k-section">
      <h2>{b.name}常见问题</h2>
      {faq.map((f) => <div class="k-qa"><h3>{f.q}</h3><p>{f.a}</p></div>)}
      <p class="k-muted">套餐数据来自 {b.name} 官网，核对于 {UPDATED_LABEL}；价格以官网结算页为准。本页“前往官网”为推广链接。</p>
    </section>
  </article>
</BaseLayout>
