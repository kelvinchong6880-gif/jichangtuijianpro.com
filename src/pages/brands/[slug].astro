---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getBrands } from '../../utils/data';

export async function getStaticPaths() {
  const brands = await getBrands();
  return brands.map(brand => ({
    params: { slug: brand.id },
    props: { brand },
  }));
}

const { brand } = Astro.props;
const { Content } = await render(brand);
const evidenceImages = brand.data.evidence_images ?? [];

const siteDomain = import.meta.env.SITE_DOMAIN || 'https://www.example-jichang.com';
const price = brand.data.price_monthly ?? brand.data.price_yearly;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: brand.data.name,
    description: `${brand.data.name} 机场套餐公开资料，核验日期 ${brand.data.verification_date}，证据状态：${brand.data.evidence_status}`,
    brand: { '@type': 'Brand', name: brand.data.name },
    offers: price ? {
      '@type': 'Offer',
      price: price,
      priceCurrency: brand.data.currency || 'CNY',
      url: brand.data.register_link,
      availability: 'https://schema.org/InStock'
    } : undefined
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${siteDomain}/` },
      { '@type': 'ListItem', position: 2, name: brand.data.name, item: `${siteDomain}/brands/${encodeURIComponent(brand.id)}/` }
    ]
  }
];
---

<style is:global>
  /* 终极暴力换行修复：针对所有嵌套元素强制生效 */
  pre.astro-code, 
  pre.astro-code * {
    white-space: pre-wrap !important;
    word-break: break-all !important;
    word-wrap: break-word !important;
    overflow-wrap: break-word !important;
  }
  pre.astro-code {
    max-width: 100% !important;
    width: 100% !important;
    padding: 1.5rem !important;
    margin: 1.5rem 0 !important;
    overflow-x: hidden !important;
    box-sizing: border-box !important;
    text-align: left !important;
  }
</style>

<BaseLayout 
  title={brand.data.seo_title || `${brand.data.name} 套餐资料与价格 - 机场推荐PRO`}
  description={brand.data.seo_description || `${brand.data.name}公开套餐资料、付款周期与注册链接。证据状态：${brand.data.evidence_status}；资料核验日期：${brand.data.verification_date}。`}
  structuredData={structuredData}
>
  <article class="max-w-6xl mx-auto bg-white shadow-sm rounded-xl overflow-hidden border border-gray-200">
    <div class="p-8">
      <div class="flex justify-between items-start border-b border-gray-100 pb-6 mb-6">
        <div>
          <div class="flex items-center gap-4">
            {brand.data.logo && (
              <img src={brand.data.logo} alt={`${brand.data.name} logo`} class="h-16 w-auto max-w-[160px] object-contain rounded-md" />
            )}
            <h1 class="text-3xl font-extrabold text-gray-900">{brand.data.seo_h1 || brand.data.name}</h1>
          </div>
          <div class="mt-2 flex items-center text-sm text-gray-500 space-x-4">
            <span>核验日期: {brand.data.verification_date}</span>
            <span class="bg-gray-100 px-2 py-0.5 rounded">{brand.data.evidence_status}</span>
            {brand.data.is_dummy && <span class="bg-yellow-100 text-yellow-800 px-2 py-0.5 rounded">演示数据</span>}
          </div>
        </div>
        <div>
          <a href={brand.data.register_link} target="_blank" rel="noopener sponsored" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700">
            前往注册
          </a>
        </div>
      </div>



      <div class="prose prose-blue max-w-none">
        {brand.data.is_sponsored && (
          <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-6">
            <p class="text-sm text-blue-700 m-0">
              <strong>商业关系披露：</strong> 本页面包含推广链接，通过此链接注册，本站可能会获得佣金。这不会影响您支付的价格，但支持了本站的运营。
            </p>
          </div>
        )}
        <Content />
      </div>

      {evidenceImages.length ? (
        <section class="mt-10 border-t border-gray-200 pt-8" aria-labelledby="node-evidence-title">
          <h2 id="node-evidence-title" class="text-2xl font-bold text-gray-900">节点延迟截图</h2>
          <p class="mt-3 text-sm text-gray-600">以下 {evidenceImages.length} 张客户端截图由站点所有者提供，本站于 2026-09-19 收到。画面显示的是节点延迟测试结果（ms），不是下载速度或带宽测试。截图未显示测试地点、运营商、设备和具体测试时间，本站尚未独立复测。</p>
          {brand.id === 'sogo' && (
            <div class="mt-5 rounded-lg border border-blue-100 bg-blue-50 p-4 text-sm text-gray-700">
              <p class="font-semibold text-gray-900">截图中可核对的示例</p>
              <p class="mt-2">新加坡01：10 ms；美国02：100 ms；日本01：46 ms；台湾10：36 ms；香港01：53 ms；直连德国01：84 ms。新加坡04与台湾04显示 Timeout。不同截图可能来自同一次列表滚动，不能据此计算整体成功率。</p>
            </div>
          )}
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            {evidenceImages.map((image, index) => (
              <figure class="overflow-hidden rounded-lg border border-gray-200 bg-gray-50">
                <a href={image.src} target="_blank" rel="noopener" aria-label={`查看${brand.data.name}节点延迟截图 ${index + 1} 原图`}>
                  <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" class="h-auto w-full" />
                </a>
                <figcaption class="px-3 py-2 text-xs text-gray-600">截图 {index + 1} / {evidenceImages.length} · 点击查看原图</figcaption>
              </figure>
            ))}
          </div>
        </section>
      ) : null}
    </div>
  </article>
</BaseLayout>
