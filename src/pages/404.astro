---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="页面未找到 (404) - 机场推荐PRO"
  description="您访问的页面不存在，可能已被移动或删除。"
>
  <div style="text-align: center; padding: 80px 20px;">
    <div style="font-size: 4rem; font-weight: 900; color: var(--pa-amber); letter-spacing: 4px;">404</div>
    <p style="color: var(--pa-text); font-size: 1.2rem; margin-top: 16px;">
      root@cnblog:~$ 找不到该路径，可能已被移动或输错网址
    </p>
    <div style="margin-top: 32px; display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
      <a href="/" style="background: var(--pa-amber); color: var(--pa-bg); padding: 10px 24px; border-radius: 4px; text-decoration: none; font-weight: bold;">返回首页</a>
      <a href="/paihangbang/" style="border: 1px solid var(--pa-amber); color: var(--pa-amber); padding: 10px 24px; border-radius: 4px; text-decoration: none; font-weight: bold;">查看机场排行榜</a>
    </div>
  </div>
</BaseLayout>
