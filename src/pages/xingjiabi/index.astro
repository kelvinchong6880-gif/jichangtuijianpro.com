---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Promo from '../../components/Promo.astro';
import BrandName from '../../components/BrandName.astro';
import {
  getBrandViews, allPlans, perGB, monthlyEq, fmtGB, fmtPrice, faqSchema, itemListSchema, breadcrumbSchema,
  UPDATED_LABEL, UPDATED_MONTH, billingLabel,
} from '../../utils/data';

const brands = await getBrandViews();
const n = brands.length;
const periodic = allPlans(brands).filter(({ p }) => p.billing !== 'One-Time' && p.traffic);
const tiers = [
  { key: 'light', title: '100–200GB 档（日常使用）', min: 100, max: 200 },
  { key: 'mid', title: '200–400GB 档（追剧）', min: 200, max: 400 },
  { key: 'heavy', title: '400–900GB 档（重度 / 多设备）', min: 400, max: 900 },
  { key: 'huge', title: '1TB 以上（家庭 / 团队）', min: 900, max: 1e9 },
].map((t) => ({
  ...t,
  rows: periodic
    .filter(({ p }) => p.billing === 'Monthly' && p.traffic! >= t.min && p.traffic! < t.max)
    .sort((a, c) => perGB(a.p)! - perGB(c.p)!)
    .slice(0, 8),
}));

const brandBest = brands.filter((b) => b.bestValue).sort((a, c) => perGB(a.bestValue!)! - perGB(c.bestValue!)!);
const premiumBest = brandBest.filter((b) => b.premium);
const champ = premiumBest[0];
const yearlyVal = periodic
  .filter(({ p }) => p.billing === 'Yearly')
  .sort((a, c) => perGB(a.p)! - perGB(c.p)!)
  .slice(0, 8);
const oneTimeVal = allPlans(brands)
  .filter(({ p }) => p.billing === 'One-Time' && p.traffic)
  .sort((a, c) => perGB(a.p)! - perGB(c.p)!)
  .slice(0, 8);
const sogo = brands.find((b) => b.slug === 'sogo')!;

const faq = [
  { q: '性价比最高的机场是哪家？', a: `只看每 GB 价格，专线机场里最划算的是 ${champ.name} 的 ${champ.bestValue!.name}：${fmtPrice(champ.bestValue!.price)}/月 ${fmtGB(champ.bestValue!.traffic)}，约 ¥${perGB(champ.bestValue!)!.toFixed(3)}/GB。如果每月用不了那么多流量，按下面的流量分档表选更合适。` },
  { q: '机场性价比怎么算？', a: '用“每月价格 ÷ 每月流量”算出每 GB 价格。年付和季付先折成每月价格再算；不限时流量包用总价除以总流量。再结合线路类型（专线优先）判断。' },
  { q: '大流量套餐一定更划算吗？', a: '每 GB 单价通常更低，但只有用得完才划算。每月只用 100GB 的人买 1TB 套餐，实际每 GB 成本反而高好几倍。先估算自己的用量，再在对应流量档里选单价最低的。' },
  { q: '性价比机场和便宜机场有什么区别？', a: '便宜机场看的是“最少花多少钱能用上”，性价比机场看的是“同样的钱能买多少流量”。预算有限、用量小，看便宜机场；用量大、想长期用，看性价比。' },
  { q: '年付比月付划算多少？', a: `很多机场年付打 8 折、两年 7 折、三年 6 折。以 Sogo云 基础版为例：月付 ¥25，年付折合 ¥20/月，三年付折合 ¥15/月。` },
];

const schemas = [
  itemListSchema(`${UPDATED_MONTH}性价比机场排行`, premiumBest.slice(0, 10)),
  faqSchema(faq),
  breadcrumbSchema([{ name: '性价比机场', path: '/xingjiabi/' }]),
];
---
<BaseLayout
  title={`性价比机场推荐2026：${n}家机场每GB价格排行（10月更新）`}
  description={`2026性价比机场推荐：把${n}家机场的套餐换算成每GB价格，按100GB、300GB、500GB、1TB流量分档排行，附年付和不限时包性价比排名。专线机场最低约¥${perGB(champ.bestValue!)!.toFixed(2)}/GB。`}
  structuredData={schemas}
  ogType="article"
>
  <div class="k-page">
    <div class="k-eyebrow"><a href="/">机场推荐</a> / 性价比机场 · 更新于 <time datetime="2026-10-04">{UPDATED_LABEL}</time></div>
    <h1>性价比机场推荐 2026：按每 GB 价格排行</h1>
    <p class="k-lead">“性价比高”不是越便宜越好，而是同样的钱能买到多少流量、线路好不好。我们把 {n} 家机场的每个套餐都换算成 <strong>每 GB 价格</strong>，再按你实际需要的流量分档排名，一眼看出哪家最划算。</p>
    <div class="k-callout">
      <p style="margin:0 0 8px"><strong style="color:var(--pa-amber)">专线机场性价比第一：{champ.name}</strong> — {champ.bestValue!.name} {fmtPrice(champ.bestValue!.price)}/月 {fmtGB(champ.bestValue!.traffic)}，约 ¥{perGB(champ.bestValue!)!.toFixed(3)}/GB，{champ.lineLabel} 线路。</p>
      <div class="k-actions"><a class="k-btn k-btn-solid" href={champ.register} target="_blank" rel="nofollow sponsored noopener">前往 {champ.name}</a><Promo code={champ.promo} /><a class="k-btn" href={champ.url}>看评测</a></div>
    </div>

    <section class="k-section">
      <h2>各家机场最划算的套餐</h2>
      <p>每家机场取每 GB 最便宜的一个周期套餐（年付折成每月计算），从低到高排序：</p>
      <div class="k-table-wrap">
        <table class="k-table">
          <thead><tr><th scope="col">#</th><th scope="col">机场</th><th scope="col">最划算套餐</th><th scope="col">价格</th><th scope="col">每月流量</th><th scope="col">每 GB</th><th scope="col">线路</th></tr></thead>
          <tbody>
            {brandBest.map((b, i) => (
              <tr class={b.slug === champ.slug ? 'is-hl' : ''}>
                <td class="k-rank">{i + 1}</td>
                <td><BrandName b={b} /></td>
                <td>{b.bestValue!.name}</td>
                <td class="k-num">{fmtPrice(b.bestValue!.price)}/{billingLabel(b.bestValue!.billing).replace('付', '')}</td>
                <td class="k-num">{fmtGB(b.bestValue!.traffic)}</td>
                <td class="k-num">¥{perGB(b.bestValue!)!.toFixed(3)}</td>
                <td>{b.lineLabel}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {tiers.map((t) => (
      <section class="k-section" id={t.key}>
        <h2>性价比机场：{t.title}</h2>
        <p>月付套餐按每 GB 价格排序。用量在这个区间的，直接选前几名。</p>
        <div class="k-table-wrap">
          <table class="k-table">
            <thead><tr><th scope="col">#</th><th scope="col">机场</th><th scope="col">套餐</th><th scope="col">月付</th><th scope="col">每月流量</th><th scope="col">每 GB</th><th scope="col">线路</th></tr></thead>
            <tbody>
              {t.rows.map(({ b, p }, i) => (
                <tr>
                  <td class="k-rank">{i + 1}</td>
                  <td><BrandName b={b} /></td>
                  <td>{p.name}</td>
                  <td class="k-num">{fmtPrice(p.price)}</td>
                  <td class="k-num">{fmtGB(p.traffic)}</td>
                  <td class="k-num">¥{perGB(p)!.toFixed(3)}</td>
                  <td>{b.lineLabel}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}

    <section class="k-section">
      <h2>年付性价比排行</h2>
      <p>年付价格折成每月后计算。年付通常需要一次付清，适合已经确定要长期用的机场。</p>
      <div class="k-table-wrap">
        <table class="k-table">
          <thead><tr><th scope="col">#</th><th scope="col">机场</th><th scope="col">套餐</th><th scope="col">年付</th><th scope="col">折合每月</th><th scope="col">每月流量</th><th scope="col">每 GB</th></tr></thead>
          <tbody>
            {yearlyVal.map(({ b, p }, i) => (
              <tr><td class="k-rank">{i + 1}</td><td><BrandName b={b} /></td><td>{p.name}</td><td class="k-num">{fmtPrice(p.price)}</td><td class="k-num">{fmtPrice(monthlyEq(p)!)}</td><td class="k-num">{fmtGB(p.traffic)}</td><td class="k-num">¥{perGB(p)!.toFixed(3)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="k-section">
      <h2>不限时流量包性价比排行</h2>
      <p>不限时包一次购买、流量不过期，按总价 ÷ 总流量计算。适合偶尔使用或做备用机场。</p>
      <div class="k-table-wrap">
        <table class="k-table">
          <thead><tr><th scope="col">#</th><th scope="col">机场</th><th scope="col">流量包</th><th scope="col">价格</th><th scope="col">总流量</th><th scope="col">每 GB</th></tr></thead>
          <tbody>
            {oneTimeVal.map(({ b, p }, i) => (
              <tr><td class="k-rank">{i + 1}</td><td><BrandName b={b} /></td><td>{p.name}</td><td class="k-num">{fmtPrice(p.price)}</td><td class="k-num">{fmtGB(p.traffic)}</td><td class="k-num">¥{perGB(p)!.toFixed(3)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="k-section">
      <h2>怎么挑性价比机场</h2>
      <ol class="k-list">
        <li><strong>先定流量档</strong>：查资料 50GB、刷视频 150GB、追剧 300GB、全家 600GB 以上，在对应流量档里比单价。</li>
        <li><strong>再看线路</strong>：同样单价，IPLC / IEPL 专线比 BGP 中转晚高峰更稳，值得多花一点。详见 <a href="/knowledge/iplc-iepl/">IPLC 与 IEPL 区别</a>。</li>
        <li><strong>注意倍率</strong>：本站收录的机场大多标明全节点 1 倍率；遇到 2 倍、3 倍扣流量的机场，实际单价要乘上倍率。见 <a href="/knowledge/traffic-multiplier/">流量倍率</a>。</li>
        <li><strong>算长期折扣</strong>：确定要长期用时，年付通常省 20%，三年付省 40%。比如 <a href={sogo.url}>Sogo云</a> 基础版三年付折合 ¥15/月。</li>
      </ol>
      <p>只想花最少的钱？看 <a href="/pianyi/">便宜机场推荐</a>。想综合比较几家？看 <a href="/duibi/">机场对比</a>。</p>
    </section>

    <section class="k-section">
      <h2>性价比机场常见问题</h2>
      {faq.map((f) => <div class="k-qa"><h3>{f.q}</h3><p>{f.a}</p></div>)}
    </section>
  </div>
</BaseLayout>
