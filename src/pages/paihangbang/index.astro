---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Promo from '../../components/Promo.astro';
import BrandName from '../../components/BrandName.astro';
import {
  getBrandViews, top10, perGB, fmtGB, fmtPrice, faqSchema, itemListSchema, breadcrumbSchema,
  UPDATED_LABEL, UPDATED_MONTH, avgEntryPrice,
} from '../../utils/data';
import { oneLiner, prosCons, unlockText } from '../../utils/review';

const brands = await getBrandViews();
const n = brands.length;
const top = top10(brands);
const avg = avgEntryPrice(brands);
const topSet = new Set(top.map((b) => b.slug));
const rest = brands.filter((b) => !topSet.has(b.slug));
const full = [...top, ...rest];

const SPECIAL: Record<string, string> = {
  sogo: '月付全 IEPL 专线、¥25 就有 150GB，节点覆盖 10 多个地区，年付 8 折到三年付 6 折，另有 4 款不限时包，轻度到重度用户都能找到合适档位。',
  feimao: '学生版 ¥84/年 是专线机场里门槛最低的年付之一，月付 ¥25 有 150GB，全 IPLC、单节点 2.5Gbps，节点数量和 Sogo云 接近。',
  weifeng: '乘风 ¥27/月 有 200GB、破风 ¥57/月 500GB，同价位流量给得足；另有 270GB、570GB 两款不限时包。',
  wuyou: '¥19/月 100GB，是前十名里月付门槛最低的一家，官网写明支持 ChatGPT、Gemini 和 4K Netflix。',
  firefly: '套餐梯度清晰：¥25/150GB、¥45/300GB、¥85/600GB、¥150/1TB，另有 ¥96 年付和 ¥100 不限时包。',
  kuajie: '无界 1.8TB 只要 ¥130/月，大流量单价在专线机场里最低；年付 8 折到三年付 6 折，优惠码还能叠加。',
  shanyue: '¥24/月 150GB、晚高峰不限速，原生 IP 解锁流媒体、ChatGPT 和 TikTok，适合做 TikTok 和 AI 的用户。',
  lingmao: '月付 Small ¥25/150GB，年付 Small ¥195（折合约 ¥16/月）性价比高，客服全天在线。',
};

const sub = [
  { title: '专线机场排行', desc: '只看 IPLC / IEPL 专线，按月付起步价排序', list: brands.filter((b) => b.premium && b.entry).sort((a, c) => a.entry!.price - c.entry!.price).slice(0, 5), val: (b: any) => `${fmtPrice(b.entry.price)}/月 · ${b.lineLabel}` },
  { title: '便宜机场排行', desc: '按月付起步价从低到高', list: brands.filter((b) => b.entry).sort((a, c) => a.entry!.price - c.entry!.price || (c.entry!.traffic ?? 0) - (a.entry!.traffic ?? 0)).slice(0, 5), val: (b: any) => `${fmtPrice(b.entry.price)}/月 ${fmtGB(b.entry.traffic)}` },
  { title: '大流量机场排行', desc: '按单个套餐最高月流量排序', list: brands.filter((b) => b.monthly.length).sort((a, c) => c.maxTraffic - a.maxTraffic).slice(0, 5), val: (b: any) => `最高 ${fmtGB(b.maxTraffic)}/月` },
  { title: '性价比机场排行', desc: '按最划算周期套餐的每 GB 价格', list: brands.filter((b) => b.bestValue).sort((a, c) => perGB(a.bestValue!)! - perGB(c.bestValue!)!).slice(0, 5), val: (b: any) => `¥${perGB(b.bestValue)!.toFixed(3)}/GB` },
  { title: '不限时机场排行', desc: '按最便宜的不限时流量包', list: brands.filter((b) => b.oneTime.length).sort((a, c) => a.oneTime[0].price - c.oneTime[0].price).slice(0, 5), val: (b: any) => `${fmtPrice(b.oneTime[0].price)} / ${fmtGB(b.oneTime[0].traffic)}` },
];

const faq = [
  { q: '2026 年机场排行榜第一名是哪家？', a: `${UPDATED_MONTH}排行榜第一名是 Sogo云：月付 ¥25 起 150GB，月付全 IEPL 专线，有年付 8 折到三年付 6 折的长期折扣和 4 款不限时流量包。Sogo云 也是本站合作品牌。` },
  { q: '机场排行榜是怎么排的？', a: '按 5 个方面综合排序：线路（IPLC/IEPL 专线优先）、月付起步价、每 GB 成本、年付和不限时等套餐灵活度、流媒体与 AI 解锁。数据全部来自各机场官网，每月核对一次。' },
  { q: '排名靠后的机场就不好吗？', a: '不一定。排名综合了多个维度，某家机场可能在单项上很突出，比如大流量单价最低或不限时包最便宜。可以直接看下方的分类排行，按你最在意的那一项选。' },
  { q: '十大机场推荐有哪些？', a: `本月前十：${top.map((b) => b.name).join('、')}。` },
  { q: '排行榜多久更新一次？', a: `每月按官网核对一次价格、流量和优惠码，本页最近更新于 ${UPDATED_LABEL}。` },
];

const schemas = [
  itemListSchema(`${UPDATED_MONTH}机场排行榜`, full),
  faqSchema(faq),
  breadcrumbSchema([{ name: '机场排行榜', path: '/paihangbang/' }]),
];
---
<BaseLayout
  title={`机场排行榜2026：${n}家机场排名与十大机场推荐（10月更新）`}
  description={`2026机场排行榜（${UPDATED_MONTH}更新）：${n}家机场按专线质量、月付价格、每GB成本综合排名，附十大机场推荐理由，以及专线、便宜、大流量、性价比、不限时分类排行和优惠码。`}
  structuredData={schemas}
  ogType="article"
>
  <div class="k-page">
    <div class="k-eyebrow"><a href="/">机场推荐</a> / 机场排行榜 · 更新于 <time datetime="2026-10-04">{UPDATED_LABEL}</time></div>
    <h1>2026 机场排行榜：{n} 家机场排名与十大机场推荐</h1>
    <p class="k-lead">我们按 <strong>线路质量、月付价格、每 GB 成本、套餐灵活度、流媒体和 AI 解锁</strong> 五个方面，给 {n} 家机场排了名。前十名逐一写了推荐理由和注意事项；后面还有专线、便宜、大流量、性价比、不限时五个分类排行，按你最在意的一项直接选。</p>

    <section class="k-section">
      <h2>十大机场推荐（{UPDATED_MONTH}）</h2>
      {top.map((b, i) => {
        const pc = prosCons(b, avg);
        return (
          <article class="k-card" style="margin-bottom:16px; gap:10px">
            <div class="k-actions" style="justify-content:space-between">
              <div class="k-actions"><span class="k-rank">#{i + 1}</span><BrandName b={b} />{i === 0 && <span class="k-pill">本站合作品牌</span>}</div>
              <div class="k-actions"><Promo code={b.promo} /><a class="k-btn k-btn-solid" href={b.register} target="_blank" rel="nofollow sponsored noopener">前往官网</a></div>
            </div>
            <p style="margin:0"><strong>推荐理由：</strong>{SPECIAL[b.slug] ?? `${oneLiner(b)}。`}</p>
            <p style="margin:0" class="k-muted">关键参数：{oneLiner(b)} · 解锁：{unlockText(b)}</p>
            {pc.cons.length > 0 && <p style="margin:0" class="k-muted">需要注意：{pc.cons.slice(0, 2).join('；')}。</p>}
            <a href={b.url}>{b.name}详细评测与全部套餐 →</a>
          </article>
        );
      })}
    </section>

    <section class="k-section">
      <h2>{n} 家机场完整排名</h2>
      <div class="k-table-wrap">
        <table class="k-table">
          <thead><tr><th scope="col">排名</th><th scope="col">机场</th><th scope="col">月付起步</th><th scope="col">年付最低</th><th scope="col">流量范围</th><th scope="col">线路</th><th scope="col">不限时</th><th scope="col">优惠码</th></tr></thead>
          <tbody>
            {full.map((b, i) => (
              <tr class={i === 0 ? 'is-hl' : ''}>
                <td class="k-rank">#{i + 1}</td>
                <td><BrandName b={b} /></td>
                <td class="k-num">{b.entry ? `${fmtPrice(b.entry.price)} / ${fmtGB(b.entry.traffic)}` : '—'}</td>
                <td class="k-num">{b.minYearly ? `${fmtPrice(b.minYearly.price)} / ${fmtGB(b.minYearly.traffic)}每月` : '—'}</td>
                <td class="k-num">{fmtGB(b.minTraffic)}–{fmtGB(b.maxTraffic)}</td>
                <td>{b.lineLabel}</td>
                <td>{b.oneTime.length ? '有' : '无'}</td>
                <td><code class="k-num">{b.promo ?? '—'}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="k-section">
      <h2>分类排行榜</h2>
      <div class="k-grid">
        {sub.map((s) => (
          <div class="k-card">
            <strong>{s.title}</strong>
            <span class="k-muted">{s.desc}</span>
            <ol class="k-list" style="margin:6px 0 0">
              {s.list.map((b) => <li><a href={b.url}>{b.name}</a> <span class="k-muted">{s.val(b)}</span></li>)}
            </ol>
          </div>
        ))}
      </div>
      <p style="margin-top:16px">想看更细的计算：<a href="/xingjiabi/">性价比机场</a>（每 GB 价格）· <a href="/pianyi/">便宜机场</a>（月付和年付最低价）· <a href="/duibi/">机场对比</a>（参数横向对比）。</p>
    </section>

    <section class="k-section">
      <h2>排名方法</h2>
      <ul class="k-list">
        <li><strong>线路</strong>：IPLC / IEPL 专线优先，晚高峰更稳定。</li>
        <li><strong>价格</strong>：以真实月付价格为准，不用“年付折合”冒充月付价。</li>
        <li><strong>每 GB 成本</strong>：用每月价格除以每月流量，比较同样的钱能买多少流量。</li>
        <li><strong>套餐灵活度</strong>：有没有年付小包、长期折扣和不限时流量包。</li>
        <li><strong>解锁</strong>：官网是否写明支持 Netflix、ChatGPT 等。</li>
      </ul>
      <p>所有数据来自各机场官网，最后核对于 {UPDATED_LABEL}。Sogo云 是本站合作品牌；网络体验会受本地运营商影响，第一次购买建议先选月付。</p>
    </section>

    <section class="k-section">
      <h2>机场排行榜常见问题</h2>
      {faq.map((f) => <div class="k-qa"><h3>{f.q}</h3><p>{f.a}</p></div>)}
    </section>
  </div>
</BaseLayout>
