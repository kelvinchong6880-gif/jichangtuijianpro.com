---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBrands } from '../../utils/data';

const allBrands = await getBrands();

const getLowestEntry = (brand: any) => {
  if (brand.data.price_monthly) return { price: brand.data.price_monthly, type: '月付' };
  if (brand.data.price_yearly) return { price: brand.data.price_yearly / 12, type: '年付折算(需一次性支付 ' + brand.data.price_yearly + ')' };
  return { price: 9999, type: '未知' };
};

const sortedBrands = allBrands
  .map(b => ({ ...b, entry: getLowestEntry(b) }))
  .sort((a, b) => a.entry.price - b.entry.price);

const faqs = [
  {
    q: '最便宜的机场大概多少钱一个月？',
    a: `按本站当前收录资料，入门价格最低的是 ${sortedBrands[0]?.data.name}，约 ${sortedBrands[0]?.data.currency} ${sortedBrands[0]?.entry.price.toFixed(1)}/月，但具体套餐条款和是否长期有效以官网结算页为准。`
  },
  {
    q: '便宜机场靠谱吗，会不会跑路？',
    a: '价格便宜和跑不跑路没有必然联系，本站也没有能力预测哪家会停止运营。比较稳妥的做法是第一次先用最短付费周期（月付或更短）试用，不要一上来就年付大额投入，观察一段时间后再决定是否长期订阅。'
  },
  {
    q: '便宜机场和贵的机场区别在哪？',
    a: '价格差异通常来自线路类型（专线 vs 普通中转）、节点数量和覆盖地区、客服响应速度等方面的官方宣称，但本站未对这些逐一独立实测，具体差异建议自己试用对比。'
  },
  {
    q: '便宜机场适合新手吗？',
    a: '适合用来低成本试错，先确认自己的实际使用场景（能不能满足日常刷视频、用AI工具等需求），再决定要不要升级到价格更高、流量更大的套餐。'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};
---

<BaseLayout title="便宜机场推荐：低预算上车指南" description="预算有限？按绝对入门价格由低到高为您整理了最便宜的节点服务商。包含真实月付与年付折算说明，避免隐藏消费。" structuredData={faqSchema}>
  
  <style>
    /* 便宜机场专属：黑金终端风格 */
    .terminal-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 2rem 1rem;
    }
    
    .terminal-header {
      position: relative;
      border-bottom: 2px dashed var(--pa-amber-border);
      padding-bottom: 2.5rem;
      margin-bottom: 3rem;
    }

    .terminal-h1 {
      font-size: 2.5rem;
      font-weight: 900;
      color: var(--pa-amber);
      display: flex;
      align-items: center;
      gap: 0.75rem;
      letter-spacing: 2px;
    }

    .terminal-cursor {
      display: inline-block;
      width: 12px;
      height: 2.5rem;
      background-color: var(--pa-amber);
      animation: blink 1s step-end infinite;
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }

    .terminal-subtitle {
      margin-top: 1.5rem;
      font-size: 1.1rem;
      color: var(--pa-text);
      line-height: 1.8;
      background: rgba(11, 10, 7, 0.6);
      padding: 1rem;
      border-left: 4px solid var(--pa-amber);
    }

    .info-box {
      background-color: rgba(255, 176, 0, 0.03);
      border: 1px solid var(--pa-amber-border);
      border-radius: 8px;
      padding: 2rem;
      margin-bottom: 3rem;
      position: relative;
      box-shadow: inset 0 0 20px rgba(255, 176, 0, 0.02);
    }
    .info-box::before {
      content: '';
      position: absolute;
      top: 0; left: 0; width: 4px; height: 100%;
      background-color: var(--pa-amber);
    }

    .highlight {
      color: var(--pa-amber);
      font-weight: bold;
    }

    .grid-container {
      display: grid;
      grid-template-columns: repeat(1, 1fr);
      gap: 1.5rem;
      margin-bottom: 3rem;
    }
    @media (min-width: 640px) { .grid-container { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1024px) { .grid-container { grid-template-columns: repeat(3, 1fr); } }

    .price-card {
      background-color: rgba(255, 176, 0, 0.02);
      border: 1px solid var(--pa-amber-border);
      border-radius: 6px;
      padding: 1.5rem;
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      position: relative;
    }
    .price-card:hover {
      border-color: var(--pa-amber);
      box-shadow: 0 4px 20px rgba(255, 176, 0, 0.15);
      transform: translateY(-3px);
      background-color: rgba(255, 176, 0, 0.04);
    }
    
    /* TOP 1 特别样式 */
    .top-1-card {
      background-color: rgba(255, 176, 0, 0.08);
      border-width: 2px;
      border-color: var(--pa-amber);
    }
    .top-1-card::after {
      content: "全网最低价";
      position: absolute;
      top: -12px;
      right: 15px;
      background: var(--pa-amber);
      color: var(--pa-bg);
      font-size: 0.75rem;
      font-weight: bold;
      padding: 2px 8px;
      border-radius: 4px;
      letter-spacing: 1px;
    }

    .card-title {
      font-size: 1.25rem;
      font-weight: 900;
      color: var(--pa-text);
      margin-bottom: 1rem;
    }
    .price-display {
      font-family: 'JetBrains Mono', monospace;
      font-size: 2rem;
      font-weight: 900;
      color: var(--pa-amber);
      display: flex;
      align-items: baseline;
      margin-bottom: 1.5rem;
      border-bottom: 1px dashed var(--pa-amber-border);
      padding-bottom: 1rem;
    }
    .price-unit {
      font-size: 0.9rem;
      color: var(--pa-text-dim);
      margin-left: 0.5rem;
    }

    .data-list {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
      color: var(--pa-text);
      flex-grow: 1;
      margin-bottom: 1.5rem;
    }
    .data-item {
      display: flex;
      justify-content: space-between;
      margin-bottom: 0.75rem;
    }
    .data-label { color: var(--pa-text-dim); }

    .action-btn {
      display: block;
      text-align: center;
      background: transparent;
      border: 1px solid var(--pa-amber-border);
      color: var(--pa-amber);
      padding: 0.6rem 1rem;
      border-radius: 4px;
      font-weight: bold;
      text-decoration: none;
      transition: all 0.2s;
    }
    .price-card:hover .action-btn {
      background: var(--pa-amber);
      color: var(--pa-bg);
      border-color: var(--pa-amber);
    }

    .faq-container {
      border-top: 1px solid var(--pa-amber-border);
      padding-top: 2rem;
    }
    .faq-title {
      font-size: 1.5rem;
      font-weight: bold;
      color: var(--pa-amber);
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .faq-item {
      background-color: rgba(0, 0, 0, 0.2);
      border: 1px solid var(--pa-amber-border);
      border-radius: 4px;
      padding: 1.5rem;
      margin-bottom: 1rem;
    }
    .faq-q { font-weight: bold; color: var(--pa-amber); margin-bottom: 0.5rem; font-size: 1.1rem; }
    .faq-a { color: var(--pa-text); font-size: 0.95rem; line-height: 1.6; }
  </style>

  <div class="terminal-container">
    
    <header class="terminal-header">
      <h1 class="terminal-h1">
        <span>[低预算检索系统]</span>
        <span class="terminal-cursor"></span>
      </h1>
      <div class="terminal-subtitle">
        <span class="highlight">> 输入指令: </span>寻找预算范围内最便宜的机场，按绝对入门价格由低到高排列。<br>
        <span class="highlight">> 系统分析: </span>不同价格和流量可能属于不同套餐。没有月付记录时使用年付折算值，并警示高首付门槛。排序靠前不代表每 GB 单价划算。
      </div>
    </header>

    <section class="info-box">
      <h2 class="text-xl font-bold mb-3 flex items-center gap-2" style="color: var(--pa-amber);">
        <span class="highlight">⚠️</span> 避坑指南：不只是看月付数字
      </h2>
      <div class="space-y-4" style="color: var(--pa-text); font-size: 0.95rem; line-height: 1.7;">
        <p>本页面按<span class="highlight">绝对入门价格</span>由低到高排序，方便预算有限的用户第一眼找到最便宜的选项。但“便宜”和“划算”是两回事——入门价最低的套餐，流量额度不一定够用。以当前收录的 {sortedBrands.length} 家品牌为例，极低月付的套餐往往流量极少（例如 30GB），折算每 GB 成本反而偏高。</p>
        <ul style="list-style-type: square; margin-left: 1.5rem; color: var(--pa-text-dim);">
          <li>先看流量额度是否够自己日常用量，再比价格。</li>
          <li>年付折算的月均价通常比月付更低，但需要一次性付清，如果是第一次尝试，建议谨慎选择年付。</li>
        </ul>
      </div>
    </section>

    <div class="grid-container">
      {sortedBrands.map((brand, index) => (
        <div class={`price-card ${index === 0 ? 'top-1-card' : ''}`}>
          <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
            {brand.data.logo && (
              <img src={brand.data.logo} alt={`${brand.data.name} logo`} style="height: 28px; width: auto; max-width: 90px; object-fit: contain; border-radius: 4px; background: rgba(255,176,0,0.05); padding: 3px; border: 1px solid rgba(255,176,0,0.2);" />
            )}
            <h3 class="card-title" style="margin-bottom: 0;">
              <a href={`/brands/${brand.id}/`} style="color: inherit; text-decoration: none;">{brand.data.name}</a>
            </h3>
          </div>
          <div class="price-display">
            {brand.entry.price.toFixed(1)}
            <span class="price-unit">{brand.data.currency} / 估算</span>
          </div>
          <div class="data-list">
            <div class="data-item">
              <span class="data-label">付款门槛:</span>
              <span style={brand.entry.type.includes('年付') ? "color:#ff4b4b" : "color:#00e572"}>{brand.entry.type}</span>
            </div>
            <div class="data-item">
              <span class="data-label">可用流量:</span>
              <span>{brand.data.bandwidth_gb} GB</span>
            </div>
          </div>
          <a href={`/brands/${brand.id}/`} class="action-btn">
            进入资料页核对
          </a>
        </div>
      ))}
    </div>

    <div class="faq-container">
      <h2 class="faq-title">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        F.A.Q / 常见问题
      </h2>
      <div class="space-y-4">
        {faqs.map(f => (
          <div class="faq-item">
            <div class="faq-q">> {f.q}</div>
            <div class="faq-a">{f.a}</div>
          </div>
        ))}
      </div>
    </div>

  </div>
</BaseLayout>
