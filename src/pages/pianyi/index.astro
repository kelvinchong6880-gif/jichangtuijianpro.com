---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandName from '../../components/BrandName.astro';
import {
  getBrandViews, allPlans, perGB, monthlyEq, fmtGB, fmtPrice, faqSchema, itemListSchema, breadcrumbSchema,
  UPDATED_LABEL, UPDATED_MONTH,
} from '../../utils/data';

const brands = await getBrandViews();
const n = brands.length;
const monthly = allPlans(brands).filter(({ p }) => p.billing === 'Monthly');
const under20 = monthly.filter(({ p }) => p.price <= 20).sort((a, c) => a.p.price - c.p.price || (c.p.traffic ?? 0) - (a.p.traffic ?? 0));
const under30 = monthly.filter(({ p }) => p.price > 20 && p.price <= 30).sort((a, c) => a.p.price - c.p.price || (c.p.traffic ?? 0) - (a.p.traffic ?? 0));
const yearly = allPlans(brands).filter(({ p }) => p.billing === 'Yearly').sort((a, c) => a.p.price - c.p.price);
const oneTime = allPlans(brands).filter(({ p }) => p.billing === 'One-Time').sort((a, c) => a.p.price - c.p.price).slice(0, 8);
const cheapestBrands = brands.filter((b) => b.entry).sort((a, c) => a.entry!.price - c.entry!.price || (c.entry!.traffic ?? 0) - (a.entry!.traffic ?? 0));
const cheapPremium = cheapestBrands.filter((b) => b.premium);
const lowest = cheapestBrands[0];
const lowestYear = yearly[0];
const sogo = brands.find((b) => b.slug === 'sogo')!;
const wuyou = brands.find((b) => b.slug === 'wuyou');

const faq = [
  { q: '最便宜的机场多少钱一个月？', a: `本站收录的机场里，月付最低 ${fmtPrice(lowest.entry!.price)}/月（${lowest.name} ${lowest.entry!.name}，${fmtGB(lowest.entry!.traffic)}）。年付最低 ${fmtPrice(lowestYear.p.price)}/年（${lowestYear.b.name}，每月 ${fmtGB(lowestYear.p.traffic)}），折合约 ${fmtPrice(lowestYear.p.price / 12)}/月。` },
  { q: '有 10 块钱以内的机场吗？', a: `按月付算，靠谱机场基本都在 ¥15 以上。所谓“¥8 一个月”通常是年付价格折算的，比如 ${lowestYear.b.name} 的 ${fmtPrice(lowestYear.p.price)}/年。如果真有月付不到 ¥10、又不写线路和倍率的机场，要特别小心。` },
  { q: '便宜机场好用吗？会不会很卡？', a: `价格低不等于线路差。本站收录的 ${cheapPremium.length} 家 IPLC/IEPL 专线机场里，有不少月付在 ¥15–¥20，比如 ${cheapPremium.slice(0, 3).map((b) => b.name).join('、')}。真正决定晚高峰卡不卡的是线路，不是价格。` },
  { q: '学生党推荐哪个便宜机场？', a: `学生主要用来查资料、用 ChatGPT，流量需求不大，选年付小包最划算：每月 40–60GB，一年 ¥79–¥99。比如 ${yearly.slice(0, 3).map(({ b, p }) => `${b.name} ${fmtPrice(p.price)}/年`).join('、')}。` },
  { q: '便宜机场容易跑路吗？', a: '跑路风险和价格没有必然关系，但长期大额预付风险更高。建议便宜机场也先买月付，用稳了再考虑年付，不要一次买两三年。详见本站的机场跑路风险防范指南。' },
];

const schemas = [
  itemListSchema(`${UPDATED_MONTH}便宜机场推荐`, cheapestBrands.slice(0, 10)),
  faqSchema(faq),
  breadcrumbSchema([{ name: '便宜机场', path: '/pianyi/' }]),
];
---
<BaseLayout
  title={`便宜机场推荐2026：月付¥15起的${n}家机场低价排行（10月更新）`}
  description={`2026便宜机场推荐：月付¥${lowest.entry!.price}起、年付¥${lowestYear.p.price}起，整理${n}家机场的最低价套餐，分月付¥20以内、¥30以内、年付小包和不限时流量包排行，附学生党推荐和优惠码。`}
  structuredData={schemas}
  ogType="article"
>
  <div class="k-page">
    <div class="k-eyebrow"><a href="/">机场推荐</a> / 便宜机场 · 更新于 <time datetime="2026-10-04">{UPDATED_LABEL}</time></div>
    <h1>便宜机场推荐 2026：月付 ¥{lowest.entry!.price} 起的低价好用机场</h1>
    <p class="k-lead">预算有限也能用上好机场。下面按 <strong>真实月付价格</strong> 排序（不用年付折算冒充月付），分成月付 ¥20 以内、¥30 以内、年付小包和不限时流量包四张表。其中 IPLC / IEPL 专线机场单独标出，便宜和稳定可以兼得。</p>

    <section class="k-section">
      <h2>便宜机场一句话推荐</h2>
      <ul class="k-list">
        <li><strong>月付最便宜</strong>：<a href={lowest.url}>{lowest.name}</a> {fmtPrice(lowest.entry!.price)}/月 {fmtGB(lowest.entry!.traffic)}（{lowest.lineLabel}）。</li>
        {wuyou && <li><strong>前十名里月付最低</strong>：<a href={wuyou.url}>{wuyou.name}</a> ¥19/月 100GB，全 IPLC 专线，官网写明支持 ChatGPT 和 4K Netflix。优惠码 <code>{wuyou.promo}</code>。</li>}
        <li><strong>一年只付一次</strong>：<a href={lowestYear.b.url}>{lowestYear.b.name}</a> {lowestYear.p.name} {fmtPrice(lowestYear.p.price)}/年，每月 {fmtGB(lowestYear.p.traffic)}。</li>
        <li><strong>便宜又稳</strong>：<a href={sogo.url}>Sogo云</a> ¥25/月 150GB 全 IEPL 专线，三年付折合 ¥15/月。优惠码 <code>{sogo.promo}</code>。</li>
      </ul>
    </section>

    <section class="k-section" id="under20">
      <h2>月付 ¥20 以内的便宜机场</h2>
      <div class="k-table-wrap">
        <table class="k-table">
          <thead><tr><th scope="col">机场</th><th scope="col">套餐</th><th scope="col">月付</th><th scope="col">每月流量</th><th scope="col">线路</th><th scope="col">优惠码</th><th scope="col"><span class="sr-only">操作</span></th></tr></thead>
          <tbody>
            {under20.map(({ b, p }) => (
              <tr><td><BrandName b={b} /></td><td>{p.name}</td><td class="k-num">{fmtPrice(p.price)}</td><td class="k-num">{fmtGB(p.traffic)}</td><td>{b.lineLabel}</td><td><code class="k-num">{b.promo ?? '—'}</code></td><td><a href={b.register} target="_blank" rel="nofollow sponsored noopener">官网</a></td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="k-section" id="under30">
      <h2>月付 ¥20–¥30 的低价机场</h2>
      <p>多花几块钱，流量通常能翻倍，主流专线机场的入门档都在这个区间。</p>
      <div class="k-table-wrap">
        <table class="k-table">
          <thead><tr><th scope="col">机场</th><th scope="col">套餐</th><th scope="col">月付</th><th scope="col">每月流量</th><th scope="col">每 GB</th><th scope="col">线路</th><th scope="col">优惠码</th></tr></thead>
          <tbody>
            {under30.map(({ b, p }) => (
              <tr class={b.slug === 'sogo' ? 'is-hl' : ''}><td><BrandName b={b} /></td><td>{p.name}</td><td class="k-num">{fmtPrice(p.price)}</td><td class="k-num">{fmtGB(p.traffic)}</td><td class="k-num">¥{perGB(p)!.toFixed(3)}</td><td>{b.lineLabel}</td><td><code class="k-num">{b.promo ?? '—'}</code></td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="k-section" id="yearly">
      <h2>年付便宜机场（适合学生党、轻度用户）</h2>
      <p>年付套餐一次付一年，其中小包每月 40–80GB，查资料、用 ChatGPT、刷社交软件足够。</p>
      <div class="k-table-wrap">
        <table class="k-table">
          <thead><tr><th scope="col">机场</th><th scope="col">套餐</th><th scope="col">年付</th><th scope="col">折合每月</th><th scope="col">每月流量</th><th scope="col">线路</th></tr></thead>
          <tbody>
            {yearly.map(({ b, p }) => (
              <tr><td><BrandName b={b} /></td><td>{p.name}</td><td class="k-num">{fmtPrice(p.price)}</td><td class="k-num">{fmtPrice(monthlyEq(p)!)}</td><td class="k-num">{fmtGB(p.traffic)}</td><td>{b.lineLabel}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="k-section" id="no-expiry">
      <h2>门槛最低的不限时流量包</h2>
      <p>一次性购买、流量不过期，一个月只用几次的人选这个最省钱。</p>
      <div class="k-table-wrap">
        <table class="k-table">
          <thead><tr><th scope="col">机场</th><th scope="col">流量包</th><th scope="col">价格</th><th scope="col">总流量</th><th scope="col">每 GB</th></tr></thead>
          <tbody>
            {oneTime.map(({ b, p }) => (
              <tr><td><BrandName b={b} /></td><td>{p.name}</td><td class="k-num">{fmtPrice(p.price)}</td><td class="k-num">{fmtGB(p.traffic)}</td><td class="k-num">¥{perGB(p)!.toFixed(3)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="k-section">
      <h2>买便宜机场的 4 个避坑提醒</h2>
      <ol class="k-list">
        <li><strong>看清“¥X 起”是不是年付折算</strong>：首页写“¥8 起”的，多半是年付价除以 12。</li>
        <li><strong>看线路和倍率</strong>：不写线路、节点 2–3 倍扣流量的低价机场，实际并不便宜。见 <a href="/knowledge/traffic-multiplier/">流量倍率</a>。</li>
        <li><strong>先月付后年付</strong>：便宜机场也先买一个月，晚高峰用稳了再长付。</li>
        <li><strong>用优惠码</strong>：表格里的优惠码在结算页填写，能再省一点。</li>
      </ol>
      <p>想比较“同样的钱能买多少流量”，看 <a href="/xingjiabi/">性价比机场排行</a>；想综合比较，看 <a href="/paihangbang/">机场排行榜</a>。</p>
    </section>

    <section class="k-section">
      <h2>便宜机场常见问题</h2>
      {faq.map((f) => <div class="k-qa"><h3>{f.q}</h3><p>{f.a}</p></div>)}
    </section>
  </div>
</BaseLayout>
