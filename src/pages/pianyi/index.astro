---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBrands } from '../../utils/data';

const allBrands = await getBrands();

const getLowestEntry = (brand: any) => {
  if (brand.data.price_monthly) return { price: brand.data.price_monthly, type: '月付' };
  if (brand.data.price_yearly) return { price: brand.data.price_yearly / 12, type: '年付折算(需一次性支付 ' + brand.data.price_yearly + ')' };
  return { price: 9999, type: '未知' };
};

const sortedBrands = allBrands
  .map(b => ({ ...b, entry: getLowestEntry(b) }))
  .sort((a, b) => a.entry.price - b.entry.price);
---

<BaseLayout title="便宜机场推荐：低预算上车指南" description="预算有限？按绝对入门价格由低到高为您整理了最便宜的节点服务商。包含真实月付与年付折算说明，避免隐藏消费。">
  
  <div class="max-w-4xl mx-auto space-y-8">
    <div class="border-b border-gray-200 pb-5">
      <h1 class="text-3xl font-extrabold text-gray-900">便宜机场</h1>
      <p class="mt-3 text-xl text-gray-500">
        按资料中的月付金额排序；没有月付记录时使用年付折算值，并显示必须一次支付的金额。不同价格和流量可能属于不同套餐，购买前请在品牌页与官网核对。
      </p>
    </div>

    <div class="prose prose-sm max-w-none text-gray-700 space-y-4">
      <h2 class="text-xl font-bold text-gray-900">便宜机场推荐怎么选，不只是看月付数字</h2>
      <p>
        本页按<strong>绝对入门价格</strong>由低到高排序，方便预算有限的用户第一眼找到最便宜的选项。但"便宜"和"划算"是两回事——入门价最低的套餐，流量额度不一定够用。以本站当前收录的 {sortedBrands.length} 家品牌为例，入门价最低的是 <a href={`/brands/${sortedBrands[0]?.id}/`} class="text-blue-600">{sortedBrands[0]?.data.name}</a>（{sortedBrands[0]?.data.currency} {sortedBrands[0]?.entry.price.toFixed(1)}/月起），流量额度约 {sortedBrands[0]?.data.bandwidth_gb}GB，价格和流量都还算均衡。
      </p>
      <p>
        但排序靠前不代表每 GB 更划算。本站资料里有品牌月付低至 ¥15，月流量却只有 30GB，折算下来每 GB 成本反而比一些月付 ¥20+、流量 100GB+ 的套餐更贵。所以只看"入门价格最低"这一项容易踩坑，建议：
      </p>
      <ul class="list-disc pl-5 space-y-1">
        <li>先看流量额度是否够自己日常用量，再比价格</li>
        <li>用"价格 ÷ 流量"粗算一下每 GB 成本，具体方法见 <a href="/xingjiabi/" class="text-blue-600">性价比机场</a> 页的计算说明</li>
        <li>年付折算的月均价通常比月付更低，但需要一次性付一整年的钱，如果是第一次尝试某个品牌，谨慎选择年付</li>
      </ul>
      <p class="text-sm text-gray-500">以下列表按入门价格排序，具体套餐条款以品牌页和官网结算页为准。</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {sortedBrands.map(brand => (
        <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6 relative">
          {brand.data.is_dummy && <span class="absolute top-2 right-2 text-[10px] bg-yellow-100 text-yellow-800 px-1 rounded">演示</span>}
          <h3 class="text-xl font-bold text-gray-900 mb-2">
            <a href={`/brands/${brand.id}/`} class="hover:text-blue-600">{brand.data.name}</a>
          </h3>
          <div class="flex items-baseline text-2xl font-extrabold text-blue-600 mb-4">
            {brand.data.currency} {brand.entry.price.toFixed(1)}
            <span class="ml-1 text-sm font-medium text-gray-500">/月估算</span>
          </div>
          <ul class="text-sm text-gray-600 space-y-2 mb-4">
            <li class="flex items-start">
              <span class="font-semibold w-20">付款门槛:</span>
              <span class={brand.entry.type.includes('年付') ? 'text-red-500' : 'text-green-600'}>{brand.entry.type}</span>
            </li>
            <li class="flex items-start">
              <span class="font-semibold w-20">可用流量:</span>
              <span>{brand.data.bandwidth_gb} GB</span>
            </li>
          </ul>
          <a href={brand.data.register_link} target="_blank" rel="noopener sponsored" class="w-full inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
            前往官网
          </a>
        </div>
      ))}
    </div>
    
  </div>

</BaseLayout>
