---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandName from '../../components/BrandName.astro';
import {
  getBrandViews, top10, perGB, fmtGB, fmtPrice, faqSchema, breadcrumbSchema,
  UPDATED_LABEL, UPDATED_MONTH, PAIRS, pairSlug,
} from '../../utils/data';
import { USAGE, cheapestFor, planPriceText, unlockText } from '../../utils/review';

const brands = await getBrandViews();
const n = brands.length;
const top = top10(brands);
const bySlug = Object.fromEntries(brands.map((b) => [b.slug, b]));

const faq = [
  { q: '机场对比要看哪些参数？', a: '最重要的是 5 项：月付价格、每月流量、线路类型（IPLC/IEPL 专线还是 BGP 中转）、是否有不限时流量包、能否解锁 Netflix 和 ChatGPT。本页的总表把这 5 项放在一起，可以直接横向比较。' },
  { q: '机场哪个好？', a: `没有对所有人都最好的机场。综合来看，${UPDATED_MONTH}本站推荐 Sogo云（¥25/月 150GB，全 IEPL 专线）；预算低选无忧（¥19/月 100GB）；流量大选跨界（1.8TB ¥130/月）。可以先按下方“按用量对比”表找到自己那一档。` },
  { q: '不同机场的流量能直接比吗？', a: '周期套餐的流量每 30 天重置，不限时包的流量用完为止、不过期，两种不能直接比数字。本页把它们分开列出，周期套餐比每月流量，不限时包比总流量和每 GB 价格。' },
  { q: '专线机场和普通机场差别大吗？', a: '主要差在晚高峰。IPLC/IEPL 专线不走拥堵的公网国际出口，晚上 8–11 点掉速、断流的概率小很多。价格上，专线机场的入门档多在 ¥15–¥27/月，和普通机场差距不大。' },
];

const schemas = [faqSchema(faq), breadcrumbSchema([{ name: '机场对比', path: '/duibi/' }])];
---
<BaseLayout
  title={`机场对比2026：${n}家机场价格、流量、线路横向对比（10月更新）`}
  description={`机场对比（${UPDATED_MONTH}更新）：${n}家机场的月付价格、年付、流量、IPLC/IEPL专线、不限时套餐和Netflix/ChatGPT解锁一表对比，按轻度、日常、追剧、重度用量推荐，附Sogo云、飞猫云、微风、无忧等热门机场两两对比。`}
  structuredData={schemas}
  ogType="article"
>
  <div class="k-page">
    <div class="k-eyebrow"><a href="/">机场推荐</a> / 机场对比 · 更新于 <time datetime="2026-10-04">{UPDATED_LABEL}</time></div>
    <h1>机场对比 2026：{n} 家机场价格、流量与线路横向对比</h1>
    <p class="k-lead">把 {n} 家机场放进同一张表：月付多少钱、每月多少流量、年付最低多少、是不是专线、有没有不限时包、能不能看 Netflix 和用 ChatGPT。下面还有按用量的对比表和热门机场两两对比，帮你快速决定“哪个机场好”。</p>

    <section class="k-section">
      <h2>热门机场两两对比</h2>
      <div class="k-grid">
        {PAIRS.map(([a, c]) => (
          <a class="k-card" href={`/duibi/${pairSlug(a, c)}/`} style="text-decoration:none">
            <strong>{bySlug[a].name} vs {bySlug[c].name}</strong>
            <span class="k-muted">{bySlug[a].name}和{bySlug[c].name}哪个好？价格、流量、线路逐项比较</span>
          </a>
        ))}
      </div>
    </section>

    <section class="k-section" id="all">
      <h2>{n} 家机场参数对比总表</h2>
      <div class="k-table-wrap">
        <table class="k-table">
          <thead><tr><th scope="col">机场</th><th scope="col">月付起步</th><th scope="col">年付最低</th><th scope="col">流量范围</th><th scope="col">最划算（每 GB）</th><th scope="col">线路</th><th scope="col">不限时</th><th scope="col">解锁</th><th scope="col">优惠码</th></tr></thead>
          <tbody>
            {brands.map((b) => (
              <tr class={b.slug === 'sogo' ? 'is-hl' : ''}>
                <td><BrandName b={b} /></td>
                <td class="k-num">{b.entry ? `${fmtPrice(b.entry.price)} / ${fmtGB(b.entry.traffic)}` : '—'}</td>
                <td class="k-num">{b.minYearly ? `${fmtPrice(b.minYearly.price)} / ${fmtGB(b.minYearly.traffic)}` : '—'}</td>
                <td class="k-num">{fmtGB(b.minTraffic)}–{fmtGB(b.maxTraffic)}</td>
                <td class="k-num">{b.bestValue ? `¥${perGB(b.bestValue)!.toFixed(3)}` : '—'}</td>
                <td>{b.lineLabel}</td>
                <td>{b.oneTime.length ? `有（${b.oneTime.length}）` : '无'}</td>
                <td>{unlockText(b)}</td>
                <td><code class="k-num">{b.promo ?? '—'}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="k-muted">“年付最低”为年付价格 / 每月流量；“最划算”为该机场每 GB 最便宜的周期套餐。</p>
    </section>

    <section class="k-section" id="usage">
      <h2>按用量对比：Top 10 机场各档最便宜套餐</h2>
      <p>同一档用量下，各家机场满足需求的最便宜套餐（年付折成每月价格）：</p>
      <div class="k-table-wrap">
        <table class="k-table">
          <thead><tr><th scope="col">机场</th>{USAGE.map((u) => <th scope="col">{u.label}（{u.need}GB+）</th>)}</tr></thead>
          <tbody>
            {top.map((b) => (
              <tr>
                <td><BrandName b={b} /></td>
                {USAGE.map((u) => {
                  const p = cheapestFor(b, u.need);
                  return <td class="k-num">{p ? planPriceText(p) : '—'}</td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="k-muted">轻度：{USAGE[0].desc}；日常：{USAGE[1].desc}；追剧：{USAGE[2].desc}；重度：{USAGE[3].desc}。</p>
    </section>

    <section class="k-section">
      <h2>机场对比的 3 个误区</h2>
      <ol class="k-list">
        <li><strong>只比“¥X 起”</strong>：起步价可能是年付折算，也可能流量很少。比同一流量档的价格才公平。</li>
        <li><strong>把不限时流量和月流量混着比</strong>：100GB 不限时包和每月 100GB 完全不是一回事。</li>
        <li><strong>忽略线路</strong>：便宜几块钱的 BGP 中转，晚高峰体验可能远不如专线。见 <a href="/knowledge/direct-relay-dedicated/">直连、中转与专线</a>。</li>
      </ol>
      <p>想看综合排名，去 <a href="/paihangbang/">机场排行榜</a>；只看价格，去 <a href="/pianyi/">便宜机场</a>；只看单价，去 <a href="/xingjiabi/">性价比机场</a>。</p>
    </section>

    <section class="k-section">
      <h2>机场对比常见问题</h2>
      {faq.map((f) => <div class="k-qa"><h3>{f.q}</h3><p>{f.a}</p></div>)}
    </section>
  </div>
</BaseLayout>
