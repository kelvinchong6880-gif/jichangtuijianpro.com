---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBrands } from '../../utils/data';

const allBrands = await getBrands();
---

<BaseLayout title="机场对比：全网节点套餐详细横向比较" description="将多个机场的套餐价格、流量限制、设备数及付款周期放在一起横向对比，帮您直观发现差异，拒绝盲目跟风。">
  
  <div class="space-y-6">
    <div>
      <h1 class="text-3xl font-extrabold text-gray-900">机场全景对比</h1>
      <p class="mt-2 text-lg text-gray-500">
        以下为品牌资料中的价格与流量记录，月付、年付及流量未必来自同一套餐，不能直接据此计算每 GB 成本。请到品牌页核对具体套餐与限制。
      </p>
    </div>

    <div class="prose prose-sm max-w-none text-gray-700 space-y-3 bg-white border border-gray-200 rounded-lg p-6">
      <h2 class="text-lg font-bold text-gray-900 mt-0">机场对比怎么做才不会被表面数字误导</h2>
      <p>把下面表格里的价格和流量直接放在一起看，很容易只被"谁便宜""谁流量大"带偏。更靠谱的对比方式是三步走：</p>
      <ol class="list-decimal pl-5 space-y-1">
        <li><strong>统一到月成本</strong>：年付套餐记得除以 12，不要拿年付总价和别家的月付价格直接比。</li>
        <li><strong>核对流量重置周期</strong>：按月重置的流量和一次性用完即止的流量池不是一回事，后者更适合用量不稳定的人，但旺季容易提前告罄。</li>
        <li><strong>看设备限制和节点倍率</strong>：同样的流量额度，如果节点是 x2 倍率消耗，实际能用的时长会打对折。</li>
      </ol>
      <p>下表只是原始资料索引，方便你先圈定 2-3 个候选，再逐个点进品牌页核对完整套餐条款后再做决定。</p>
    </div>

    <div class="flex flex-col">
      <div class="-my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
        <div class="py-2 align-middle inline-block min-w-full sm:px-6 lg:px-8">
          <div class="shadow overflow-hidden border-b border-gray-200 sm:rounded-lg">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">品牌</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">月付/年付</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">流量 (周期)</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">设备限制</th>
                  <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">核验日期</th>
                  <th scope="col" class="relative px-6 py-3"><span class="sr-only">操作</span></th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                {allBrands.map((brand: any) => (
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="flex items-center">
                        <div class="text-sm font-medium text-gray-900">
                          {brand.data.name}
                          {brand.id === 'sogo' && <span class="ml-1 text-[10px] bg-blue-100 text-blue-800 px-1 rounded">主推</span>}
                        </div>
                      </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm text-gray-900">{brand.id === 'sogo' ? '基础版 ¥25/月（150GB/30天）；小包 ¥98/年（60GB/30天）' : `${brand.data.currency} ${brand.data.price_monthly || '-'} / ${brand.data.price_yearly || '-'}`}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="text-sm text-gray-900">{brand.id === 'sogo' ? '见对应套餐' : `${brand.data.bandwidth_gb} GB`}</div>
                      <div class="text-xs text-gray-500">{brand.id === 'sogo' ? '两档均每 30 天刷新' : brand.data.bandwidth_reset_period}</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      {brand.data.device_limit || '未知'}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                      {brand.data.verification_date}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                      <a href={`/brands/${brand.id}/`} class="text-blue-600 hover:text-blue-900">详情</a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    
  </div>

</BaseLayout>
