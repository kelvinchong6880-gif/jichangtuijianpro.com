---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBrands } from '../../utils/data';

const allBrands = await getBrands();

const PLATFORM_KEYWORDS = ['Netflix', 'Disney+', 'ChatGPT', 'TikTok'];

function extractUnlockPlatforms(brand: any): string[] {
  const features: string[] = brand.data.features ?? [];
  const line = features.find(f => f.includes('流媒体解锁') || f.includes('解锁'));
  if (!line) return [];
  return PLATFORM_KEYWORDS.filter(p => line.includes(p));
}

const withUnlockInfo = allBrands
  .map(brand => ({ brand, platforms: extractUnlockPlatforms(brand) }))
  .filter(x => x.platforms.length > 0)
  .sort((a, b) => b.platforms.length - a.platforms.length);

const noInfoCount = allBrands.length - withUnlockInfo.length;
---

<BaseLayout
  title="流媒体解锁机场推荐：Netflix / Disney+ / ChatGPT 解锁资料整理"
  description="哪些机场官方资料标注支持解锁 Netflix、Disney+、ChatGPT、TikTok？本文按各品牌官网公开信息整理，本站未逐一验证实际解锁效果。"
>
  <div class="max-w-4xl mx-auto space-y-8">
    <div class="border-b border-gray-200 pb-5">
      <h1 class="text-3xl font-extrabold text-gray-900">流媒体解锁机场推荐</h1>
      <p class="mt-3 text-xl text-gray-500">
        以下按各品牌<strong>官网公开资料</strong>中标注的"流媒体解锁"信息整理，按标注支持的平台数量排序。这些都是商家自己的说法，本站尚未逐一测试实际解锁效果、原生 IP 情况或长期稳定性，具体请以购买时的实测为准。
      </p>
      {noInfoCount > 0 && (
        <p class="mt-2 text-sm text-gray-400">另有 {noInfoCount} 家收录品牌未在公开资料中明确标注解锁平台，未列入下方名单，不代表其不支持解锁。</p>
      )}
    </div>

    <div class="space-y-6">
      {withUnlockInfo.map(({ brand, platforms }) => (
        <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center flex-wrap gap-2">
            <h2 class="text-xl font-bold text-gray-900">
              <a href={`/brands/${encodeURIComponent(brand.id)}/`} class="hover:text-blue-600">{brand.data.name}</a>
            </h2>
            <div class="flex gap-2 flex-wrap">
              {platforms.map(p => (
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">{p}</span>
              ))}
            </div>
          </div>
          <div class="p-6 flex justify-between items-center flex-wrap gap-3">
            <div class="text-sm text-gray-600">
              {brand.data.price_monthly ? `${brand.data.currency} ${brand.data.price_monthly}/月起` : (brand.data.price_yearly ? `${brand.data.currency} ${brand.data.price_yearly}/年起` : '价格资料未提供')}
              　·　{brand.data.evidence_status}
            </div>
            <a href={`/brands/${encodeURIComponent(brand.id)}/`} class="text-blue-600 hover:text-blue-500 text-sm font-medium">查看完整套餐资料 &rarr;</a>
          </div>
        </div>
      ))}
    </div>

    <div class="border-t border-gray-200 pt-6 text-sm text-gray-500">
      <p>解锁能力受节点 IP 池、当时被封锁情况、客户端设置等多个因素影响，同一家机场不同时间的解锁情况也可能变化。建议购买前先用最短付费周期实际测试你最常用的平台，而不是只看官网宣传。</p>
      <p class="mt-2">想按价格或性价比而不是解锁能力挑选，可以看 <a href="/pianyi/" class="text-blue-600">便宜机场推荐</a> 或 <a href="/xingjiabi/" class="text-blue-600">性价比机场推荐</a>。</p>
    </div>
  </div>

</BaseLayout>
