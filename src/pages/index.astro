---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBrands } from '../utils/data';

const allBrands = await getBrands();
const sogoBrand = allBrands.find(b => b.id === 'sogo');
const otherBrands = allBrands.filter(b => b.id !== 'sogo');
---

<BaseLayout title="2026 机场推荐：性价比、优质稳定节点全收录" description="最新的机场推荐列表，包含 Sogo云 等经过初步收集整理的节点服务商。根据需求筛选最适合您的便宜、高性价比或稳定机场。">
  
  <div class="space-y-12">
    <!-- 英雄区 -->
    <section class="text-center py-12 bg-white rounded-2xl shadow-sm border border-gray-100">
      <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight sm:text-5xl">
        寻找最适合您的机场网络
      </h1>
      <p class="mt-4 text-lg text-gray-500 max-w-3xl mx-auto">
        本站通过对比分析和部分实测，为您提供不同需求的机场推荐。请注意，所有的服务均存在风险，推荐建议按月支付以降低损失可能。
      </p>
    </section>

    <!-- 演示数据提示 -->
    {allBrands.some(b => b.data.is_dummy) && (
      <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded-md">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-yellow-700">
              <strong>当前包含演示数据。</strong> 下方展示的部分品牌信息及链接均为占位符，正式线上部署时将自动隐藏此数据，如有占位域名也会阻止发布。
            </p>
          </div>
        </div>
      </div>
    )}

    <!-- 本站主推 Sogo云 -->
    {sogoBrand && (
      <section>
        <h2 class="text-2xl font-bold text-gray-900 border-l-4 border-blue-500 pl-3 mb-6">本站主推</h2>
        <div class="bg-white rounded-xl shadow-md overflow-hidden border border-blue-100 hover:shadow-lg transition-shadow">
          <div class="md:flex">
            <div class="p-8 w-full">
              <div class="flex justify-between items-start">
                <div>
                  <div class="uppercase tracking-wide text-sm text-blue-500 font-semibold mb-1">
                    {sogoBrand.data.is_sponsored ? '合作伙伴 / 推荐' : '精选'}
                  </div>
                  <a href={`/brands/${sogoBrand.id}/`} class="block mt-1 text-2xl leading-tight font-bold text-black hover:underline">
                    {sogoBrand.data.name}
                  </a>
                  <p class="mt-2 text-gray-500">
                    最低消费：{sogoBrand.data.currency} {sogoBrand.data.price_monthly}/月，流量 {sogoBrand.data.bandwidth_gb} GB。
                  </p>
                </div>
                <div class="text-right">
                  <a href={sogoBrand.data.register_link} target="_blank" rel="noopener sponsored" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700">
                    前往官网
                  </a>
                  <p class="text-xs text-gray-400 mt-2">核验于: {sogoBrand.data.verification_date}</p>
                </div>
              </div>
              <div class="mt-4 prose text-gray-500 line-clamp-3">
                基于目前收录资料，此品牌提供较为平衡的价格与流量，适合大部分普通网络浏览及流媒体需求的用户。
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 其他选择 -->
    <section>
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-gray-900 border-l-4 border-gray-400 pl-3">更多收录选择</h2>
        <a href="/duibi/" class="text-sm font-medium text-blue-600 hover:text-blue-500">查看完整对比 &rarr;</a>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {otherBrands.map(brand => (
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 flex flex-col">
            <h3 class="text-lg font-medium text-gray-900">
              <a href={`/brands/${brand.id}/`} class="hover:text-blue-600">{brand.data.name}</a>
            </h3>
            <div class="mt-2 text-sm text-gray-500 flex-grow">
              <ul class="space-y-1">
                <li>价格: {brand.data.currency} {brand.data.price_monthly || '-'}/月</li>
                <li>流量: {brand.data.bandwidth_gb}GB</li>
                {brand.data.multiplier_desc && <li class="text-orange-500">限制: {brand.data.multiplier_desc}</li>}
              </ul>
            </div>
            <div class="mt-4 pt-4 border-t border-gray-100">
              <span class="text-xs text-gray-400 bg-gray-100 px-2 py-1 rounded">{brand.data.evidence_status}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-12 max-w-3xl">
      <h2 class="text-2xl font-bold text-gray-900 border-l-4 border-gray-400 pl-3 mb-6">常见问题</h2>
      <div class="space-y-6 text-gray-700">
        <div>
          <h3 class="font-semibold text-gray-900">怎么判断一个机场好不好用？</h3>
          <p class="mt-1 text-sm">主要看三点：晚高峰会不会明显降速、是否支持常用的流媒体和 AI 工具解锁、出问题时客服响应速度。本站按<a href="/xingjiabi/" class="text-blue-600">性价比</a>、<a href="/pianyi/" class="text-blue-600">价格</a>、<a href="/youzhi/" class="text-blue-600">线路质量</a>三个维度分别整理了列表，可以按自己最在意的维度去挑。</p>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900">好用的梯子（机场）怎么选？</h3>
          <p class="mt-1 text-sm">"梯子"通常就是指机场这类代理订阅服务。新手可以先看<a href="/paihangbang/" class="text-blue-600">机场排行榜</a>和<a href="/duibi/" class="text-blue-600">机场对比</a>页面，用短周期套餐试用后再决定是否长期订阅，避免一次性年付踩坑。</p>
        </div>
        <div>
          <h3 class="font-semibold text-gray-900">用什么客户端软件导入机场订阅？</h3>
          <p class="mt-1 text-sm">Windows/Mac/Linux 常用 <a href="/clash/" class="text-blue-600">Clash</a> 或 <a href="/v2rayn/" class="text-blue-600">V2rayN</a>，iOS 常用 <a href="/xiaohuojian/" class="text-blue-600">小火箭 (Shadowrocket)</a>，Android 可参考<a href="/tutorial/android/" class="text-blue-600">安卓教程</a>。</p>
        </div>
      </div>
    </section>
  </div>

</BaseLayout>
