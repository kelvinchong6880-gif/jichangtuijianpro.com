---
import BaseLayout from '../layouts/BaseLayout.astro';
import Promo from '../components/Promo.astro';
import BrandName from '../components/BrandName.astro';
import {
  getBrandViews, top10, allPlans, perGB, fmtGB, fmtPrice, faqSchema, itemListSchema,
  UPDATED_LABEL, UPDATED_MONTH, PAIRS, pairSlug,
} from '../utils/data';
import { unlockText } from '../utils/review';

const brands = await getBrandViews();
const n = brands.length;
const top = top10(brands);
const sogo = brands.find((b) => b.slug === 'sogo')!;
const bySlug = Object.fromEntries(brands.map((b) => [b.slug, b]));

const monthly = allPlans(brands).filter(({ p }) => p.billing === 'Monthly');
const cheapest = [...monthly].sort((a, c) => a.p.price - c.p.price || (c.p.traffic ?? 0) - (a.p.traffic ?? 0))[0];
const yearly = allPlans(brands).filter(({ p }) => p.billing === 'Yearly').sort((a, c) => a.p.price - c.p.price)[0];
const bigValue = monthly
  .filter(({ b, p }) => (p.traffic ?? 0) >= 1000 && b.premium)
  .sort((a, c) => perGB(a.p)! - perGB(c.p)!)[0];
const oneTime = allPlans(brands).filter(({ p }) => p.billing === 'One-Time').sort((a, c) => a.p.price - c.p.price)[0];
const premiumCount = brands.filter((b) => b.premium).length;

const picks = [
  { tag: '综合首推', b: sogo, text: `月付 ¥${sogo.entry!.price} 起 ${fmtGB(sogo.entry!.traffic)}，全 IEPL 专线，晚高峰不降速。`, href: sogo.url },
  { tag: '最便宜月付', b: cheapest.b, text: `${cheapest.p.name}：¥${cheapest.p.price}/月 ${fmtGB(cheapest.p.traffic)}。`, href: '/pianyi/' },
  { tag: '年付最便宜', b: yearly.b, text: `${yearly.p.name}：¥${yearly.p.price}/年，每月 ${fmtGB(yearly.p.traffic)}。`, href: '/pianyi/' },
  { tag: '大流量性价比', b: bigValue.b, text: `${bigValue.p.name}：¥${bigValue.p.price}/月 ${fmtGB(bigValue.p.traffic)}，约 ¥${perGB(bigValue.p)!.toFixed(3)}/GB。`, href: '/xingjiabi/' },
  { tag: '不限时备用', b: oneTime.b, text: `${oneTime.p.name}：¥${oneTime.p.price} 买 ${fmtGB(oneTime.p.traffic)}，流量不过期。`, href: oneTime.b.url },
];

const faq = [
  { q: '2026 年机场推荐哪家？', a: `${UPDATED_MONTH}本站首推 Sogo云：月付 ¥25 起 150GB，全 IEPL 专线，节点覆盖香港、日本、新加坡、美国等 10 多个地区。预算更低可以看 ${cheapest.b.name}（¥${cheapest.p.price}/月起），流量大的可以看 ${bigValue.b.name}。完整名单见机场排行榜。` },
  { q: '机场是什么？和 VPN 有什么区别？', a: '“机场”是代理订阅服务的俗称：服务商提供一批海外节点，你把订阅链接导入 Clash、小火箭等客户端就能使用。和传统 VPN 相比，机场节点更多、价格更低，在国内的连接成功率也更高。' },
  { q: '新手买机场要注意什么？', a: '优先选 IPLC/IEPL 专线机场；分清“月付价”和“年付折合价”；按实际用量买流量；第一次只买一个月，满意后再年付。避开只写“¥8 起”却不写月付价格、或者倍率很高的机场。' },
  { q: '便宜的机场能用吗？', a: `能用。本站收录的机场里，¥15–¥20/月 就能买到 100–150GB 的套餐，其中不少是专线。真正要小心的是没有月付、线路不写清楚的超低价机场。具体名单见便宜机场推荐。` },
  { q: '机场多少流量够用？', a: '只查资料、用 AI：每月 50GB 足够；每天看 1–2 小时视频：约 150GB；经常追 4K 剧：300GB 以上；全家多设备共用：600GB 以上。' },
  { q: '买了机场用什么软件？', a: 'Windows 和 Mac 用 Clash Verge 或 V2rayN，iPhone 用小火箭（Shadowrocket），安卓用 Clash Meta。本站有每个客户端的图文教程。' },
];

const schemas = [itemListSchema(`${UPDATED_MONTH}机场推荐 Top 10`, top), faqSchema(faq)];
---
<BaseLayout
  title={`机场推荐2026：${n}家好用机场对比与Top 10排行（10月更新）`}
  description={`2026机场推荐（${UPDATED_MONTH}更新）：整理${n}家机场的月付价格、流量、IPLC/IEPL专线与优惠码，按预算和用量推荐。本月首推Sogo云：¥25/月150GB全IEPL专线，晚高峰不降速。`}
  structuredData={schemas}
>
  <div class="k-page">
    <section>
      <div class="k-eyebrow">更新于 <time datetime="2026-10-04">{UPDATED_LABEL}</time> · 收录 {n} 家机场</div>
      <h1>机场推荐 2026：{n} 家好用机场价格、线路与流量对比</h1>
      <p class="k-lead">不知道买哪家机场？我们把 {n} 家机场官网的套餐逐一整理成表：月付多少钱、每月多少流量、是不是 IPLC/IEPL 专线、能不能看 Netflix 和用 ChatGPT、有没有优惠码。其中 {premiumCount} 家是专线机场。按预算和用量对号入座，几分钟就能选好。</p>
      <div class="k-callout">
        <p style="margin:0 0 10px"><strong style="color:var(--pa-amber)">本月首推：Sogo云</strong> — ¥25/月 150GB，月付全 IEPL 专线，单节点峰值 2.5Gbps，晚高峰不降速，原生 IP 解锁 Netflix / ChatGPT。</p>
        <div class="k-actions">
          <a class="k-btn k-btn-solid" href={sogo.register} target="_blank" rel="nofollow sponsored noopener">前往 Sogo云 官网</a>
          <Promo code={sogo.promo} />
          <a class="k-btn" href={sogo.url}>看 Sogo云 评测</a>
        </div>
      </div>
    </section>

    <section class="k-section" id="top10">
      <h2>{UPDATED_MONTH}机场推荐 Top 10</h2>
      <p>按线路质量、月付价格、每 GB 成本和套餐灵活度综合挑选。想看每家的推荐理由，请看 <a href="/paihangbang/">机场排行榜</a>。</p>
      <div class="k-table-wrap">
        <table class="k-table">
          <thead><tr><th scope="col">排名</th><th scope="col">机场</th><th scope="col">月付起步</th><th scope="col">线路</th><th scope="col">流量范围</th><th scope="col">解锁</th><th scope="col">优惠码</th><th scope="col"><span class="sr-only">操作</span></th></tr></thead>
          <tbody>
            {top.map((b, i) => (
              <tr class={i === 0 ? 'is-hl' : ''}>
                <td class="k-rank">#{i + 1}</td>
                <td><BrandName b={b} /></td>
                <td class="k-num">{b.entry ? `${fmtPrice(b.entry.price)}/${fmtGB(b.entry.traffic)}` : '—'}</td>
                <td>{b.lineLabel}</td>
                <td class="k-num">{fmtGB(b.minTraffic)}–{fmtGB(b.maxTraffic)}</td>
                <td>{unlockText(b)}</td>
                <td><code class="k-num">{b.promo ?? '—'}</code></td>
                <td><a class="k-btn" style="padding:4px 10px" href={b.register} target="_blank" rel="nofollow sponsored noopener">官网</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="k-section">
      <h2>按需求推荐机场</h2>
      <div class="k-grid">
        {picks.map((x) => (
          <a class="k-card" href={x.href} style="text-decoration:none">
            <span class="k-tag">{x.tag}</span>
            <strong>{x.b.name}</strong>
            <span class="k-muted">{x.text}</span>
          </a>
        ))}
      </div>
      <p style="margin-top:16px">更多分类：<a href="/xingjiabi/">性价比机场</a> · <a href="/pianyi/">便宜机场</a> · <a href="/youzhi/">优质机场</a> · <a href="/liumeijiesuo/">Netflix / ChatGPT 解锁机场</a> · <a href="/duibi/">机场对比</a></p>
    </section>

    <section class="k-section">
      <h2>机场推荐怎么选？记住这 4 点</h2>
      <h3>1. 线路：优先 IPLC / IEPL 专线</h3>
      <p>普通中转线路走公网国际出口，晚上 8–11 点容易掉速。IPLC 和 IEPL 是跨境专线，延迟低、晚高峰稳。本站收录的 {n} 家里有 {premiumCount} 家专线机场，详见 <a href="/knowledge/iplc-iepl/">IPLC 与 IEPL 是什么</a>。</p>
      <h3>2. 价格：看月付，不要只看“¥8 起”</h3>
      <p>“¥8 起”通常是年付总价除以 12，而且每月只有 40–60GB。真正的月付价格在 ¥15–¥30 之间。很多机场年付 8 折、三年付 6 折，先月付试用再长付最划算。想按单价比，看 <a href="/xingjiabi/">性价比机场排行</a>。</p>
      <h3>3. 流量：按实际用量买</h3>
      <p>查资料和用 AI 每月 50GB 够用，天天刷视频约 150GB，追 4K 剧要 300GB 以上，全家共用 600GB 起步。偶尔才用的，选 <a href="/knowledge/unlimited/">不限时流量包</a> 更省。</p>
      <h3>4. 售后：先小额试用</h3>
      <p>机场行业流动性大，再好的机场也建议先买一个月。看 <a href="/knowledge/risk-guide/">机场跑路风险防范</a>，了解怎么降低风险。</p>
    </section>

    <section class="k-section">
      <h2>热门机场对比</h2>
      <p>拿不定主意时，看看两家放在一起比：</p>
      <div class="k-grid">
        {PAIRS.map(([a, c]) => (
          <a class="k-card" href={`/duibi/${pairSlug(a, c)}/`} style="text-decoration:none">
            <strong>{bySlug[a].name} 和 {bySlug[c].name} 哪个好？</strong>
            <span class="k-muted">价格、流量、线路逐项对比</span>
          </a>
        ))}
      </div>
    </section>

    <section class="k-section">
      <h2>买完机场怎么用</h2>
      <p>把订阅链接导入客户端即可：<a href="/clash/">Clash 教程</a>（Windows / Mac / 安卓）、<a href="/xiaohuojian/">小火箭教程</a>（iPhone）、<a href="/v2rayn/">V2rayN 教程</a>（Windows）。完整的分平台说明见 <a href="/tutorial/">使用教程</a>。</p>
    </section>

    <section class="k-section k-faq">
      <h2>机场推荐常见问题</h2>
      {faq.map((f) => (
        <div class="k-qa"><h3>{f.q}</h3><p>{f.a}</p></div>
      ))}
    </section>
  </div>
</BaseLayout>
