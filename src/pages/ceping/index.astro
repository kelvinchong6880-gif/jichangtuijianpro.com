---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandName from '../../components/BrandName.astro';
import { getBrandViews, itemListSchema, breadcrumbSchema, UPDATED_LABEL, UPDATED_MONTH } from '../../utils/data';
import { oneLiner, unlockText } from '../../utils/review';

const brands = await getBrandViews();
const n = brands.length;
const schemas = [itemListSchema(`${UPDATED_MONTH}机场测评`, brands), breadcrumbSchema([{ name: '机场测评', path: '/ceping/' }])];
---
<BaseLayout
  title={`机场测评2026：${n}家机场逐一评测（套餐、线路、优惠码）`}
  description={`${n}家机场逐一评测（${UPDATED_MONTH}更新）：Sogo云、飞猫云、微风、无忧、跨界等机场怎么样，每家都有完整套餐价格表、按用量选购建议、优缺点、同价位对比和优惠码。`}
  structuredData={schemas}
>
  <div class="k-page">
    <div class="k-eyebrow"><a href="/">机场推荐</a> / 机场测评 · 更新于 {UPDATED_LABEL}</div>
    <h1>机场测评：{n} 家机场逐一评测</h1>
    <p class="k-lead">想知道某家机场怎么样？每篇评测都包含完整套餐价格表、按用量怎么选、优缺点、同价位对比和购买步骤。按本站排行榜顺序排列。</p>
    <section class="k-section">
      <div class="k-grid" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
        {brands.map((b, i) => (
          <div class="k-card">
            <div class="k-actions"><span class="k-rank">#{i + 1}</span><BrandName b={b} /></div>
            <span class="k-muted">{oneLiner(b)}</span>
            <span class="k-muted">解锁：{unlockText(b)}{b.promo ? ` · 优惠码 ${b.promo}` : ''}</span>
            <a href={b.url}>{b.name}怎么样？看评测 →</a>
          </div>
        ))}
      </div>
    </section>
    <p>按需求挑选：<a href="/paihangbang/">机场排行榜</a> · <a href="/xingjiabi/">性价比机场</a> · <a href="/pianyi/">便宜机场</a> · <a href="/duibi/">机场对比</a></p>
  </div>
</BaseLayout>
