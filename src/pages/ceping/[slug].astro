---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render, getCollection } from 'astro:content';
import { getBrands } from '../../utils/data';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const isDev = import.meta.env.DEV;
  const isPreview = import.meta.env.IS_PREVIEW === 'true';
  const posts = (isDev || isPreview) ? allPosts : allPosts.filter(p => !p.id.startsWith('_'));

  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const siteDomain = import.meta.env.SITE_DOMAIN || 'https://www.example-jichang.com';

// 尝试关联到同名的品牌资料页（测评文章的 slug 与品牌 id 一致时）
const allBrands = await getBrands();
const relatedBrand = allBrands.find(b => b.id === post.id);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date?.toISOString?.() ?? undefined,
    dateModified: (post.data.updatedDate ?? post.data.date)?.toISOString?.() ?? undefined,
    author: { '@type': 'Organization', name: '机场推荐PRO' }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${siteDomain}/` },
      { '@type': 'ListItem', position: 2, name: '测评文章', item: `${siteDomain}/ceping/` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: `${siteDomain}/ceping/${encodeURIComponent(post.id)}/` }
    ]
  }
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  structuredData={structuredData}
>
  <div class="container">
    <div style="margin-bottom: 2rem;">
      <div class="breadcrumbs" style="margin-bottom: 1rem; color: var(--text-muted); font-size: 0.9rem;">
        <a href="/" style="color: var(--primary); text-decoration: none;">首页</a> &gt; <a href="/ceping/" style="color: var(--primary); text-decoration: none;">测评文章</a> &gt; <span>{post.data.title}</span>
      </div>
      <h1>{post.data.title}</h1>
      <div style="color: var(--text-muted); font-size: 0.85rem; margin-top: 0.5rem;">
        发布日期：{post.data.date?.toISOString?.().slice(0, 10)}
        {post.data.updatedDate && <> · 更新日期：{post.data.updatedDate.toISOString().slice(0, 10)}</>}
      </div>
    </div>

    <div class="article-content" style="background: var(--card-bg); padding: 2rem; border-radius: 8px; border: 1px solid var(--border-color);">
      {relatedBrand && (
        <div style="background: var(--bg-alt); padding: 1rem 1.5rem; border-radius: 8px; margin-bottom: 2rem; border-left: 4px solid var(--primary);">
          本文是编辑点评角度的测评文章。完整套餐价格表、流量规则与资料来源，请看 <a href={`/brands/${encodeURIComponent(relatedBrand.id)}/`} style="color: var(--primary); font-weight: bold;">{relatedBrand.data.name} 官方套餐资料页 →</a>
        </div>
      )}

      <Content />

      {relatedBrand && (
        <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color); display: flex; gap: 1rem; flex-wrap: wrap;">
          <a href={relatedBrand.data.register_link} target="_blank" rel="noopener sponsored" style="display: inline-block; background: var(--primary); color: #fff; padding: 0.6rem 1.2rem; border-radius: 4px; text-decoration: none; font-weight: bold;">前往 {relatedBrand.data.name} 官网</a>
          <a href={`/brands/${encodeURIComponent(relatedBrand.id)}/`} style="display: inline-block; border: 1px solid var(--primary); color: var(--primary); padding: 0.6rem 1.2rem; border-radius: 4px; text-decoration: none; font-weight: bold;">查看完整套餐资料</a>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
