---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render, getCollection } from 'astro:content';
import { getBrands } from '../../utils/data';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const isDev = import.meta.env.DEV;
  const isPreview = import.meta.env.IS_PREVIEW === 'true';
  const posts = (isDev || isPreview) ? allPosts : allPosts.filter(p => !p.id.startsWith('_'));

  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const siteDomain = import.meta.env.SITE_DOMAIN || 'https://www.example-jichang.com';

// 尝试关联到同名的品牌资料页（测评文章的 slug 与品牌 id 一致时）
const allBrands = await getBrands();
const relatedBrand = allBrands.find(b => b.id === post.id);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date?.toISOString?.() ?? undefined,
    dateModified: (post.data.updatedDate ?? post.data.date)?.toISOString?.() ?? undefined,
    author: { '@type': 'Organization', name: '机场推荐PRO' }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${siteDomain}/` },
      { '@type': 'ListItem', position: 2, name: '测评文章', item: `${siteDomain}/ceping/` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: `${siteDomain}/ceping/${encodeURIComponent(post.id)}/` }
    ]
  }
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  structuredData={structuredData}
>
  <article class="max-w-6xl mx-auto bg-white shadow-sm rounded-xl overflow-hidden border border-gray-200">
    <div class="p-8">
      
      <div class="flex justify-between items-start border-b border-gray-100 pb-6 mb-6">
        <div>
          <div class="text-sm text-gray-500 mb-2">
            <a href="/" class="hover:text-blue-600 transition-colors">首页</a> &gt; 
            <a href="/ceping/" class="hover:text-blue-600 transition-colors">测评文章</a> &gt; 
            <span class="text-gray-900">{post.data.title}</span>
          </div>
          <h1 class="text-3xl font-extrabold text-gray-900 mt-2">{post.data.title}</h1>
          <div class="mt-3 flex items-center text-sm text-gray-500 space-x-4">
            <span>发布日期：{post.data.date?.toISOString?.().slice(0, 10)}</span>
            {post.data.updatedDate && <span>· 更新日期：{post.data.updatedDate.toISOString().slice(0, 10)}</span>}
          </div>
        </div>
      </div>

      <div class="prose prose-blue max-w-none">
        {relatedBrand && (
          <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-6 rounded-r-md">
            <p class="text-sm text-blue-700 m-0">
              <strong>提示：</strong> 本文是编辑点评角度的测评文章。完整套餐价格表、流量规则与资料来源，请看 
              <a href={`/brands/${encodeURIComponent(relatedBrand.id)}/`} class="font-bold underline text-blue-800 hover:text-blue-900">{relatedBrand.data.name} 官方套餐资料页 &rarr;</a>
            </p>
          </div>
        )}

        <Content />
      </div>
      {relatedBrand && (
          <div class="mt-8 pt-6 border-t border-gray-200 flex gap-4 flex-wrap">
            <a href={relatedBrand.data.register_link} target="_blank" rel="noopener sponsored" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 transition-colors no-underline">
              前往 {relatedBrand.data.name} 官网
            </a>
            <a href={`/brands/${encodeURIComponent(relatedBrand.id)}/`} class="inline-flex items-center px-6 py-3 border border-blue-600 text-base font-medium rounded-md text-blue-600 bg-transparent hover:bg-blue-50 transition-colors no-underline">
              查看完整套餐资料
            </a>
          </div>
        )}
      
    </div>
  </article>
</BaseLayout>
